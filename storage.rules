rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper: user is authenticated and active
    function isAuth() {
      return request.auth != null;
    }

    // Helper: check Firestore user role
    function userRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuth() && userRole() == 'admin';
    }

    function isManager() {
      return isAuth() && (userRole() == 'admin' || userRole() == 'manager');
    }

    // Expense receipts: managers+ can upload, all authenticated can read
    match /expenses/{fileName} {
      allow read: if isAuth();
      allow write: if isManager()
                   && request.resource.size < 5 * 1024 * 1024  // 5MB max
                   && request.resource.contentType.matches('image/.*');
    }

    // Product images: managers+ can upload, all authenticated can read
    match /products/{fileName} {
      allow read: if isAuth();
      allow write: if isManager()
                   && request.resource.size < 5 * 1024 * 1024  // 5MB max
                   && request.resource.contentType.matches('image/.*');
    }

    // Company logo: admin only can upload, all authenticated can read
    match /settings/{fileName} {
      allow read: if isAuth();
      allow write: if isAdmin()
                   && request.resource.size < 2 * 1024 * 1024  // 2MB max
                   && request.resource.contentType.matches('image/.*');
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
