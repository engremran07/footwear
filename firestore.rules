rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return isAuthenticated() && userDoc().data.active == true;
    }

    function getUserRole() {
      return userDoc().data.role;
    }

    function isAdminRole(role) {
      return role == 'admin' ||
        role == 'manager' ||
        role == 'Admin' ||
        role == 'Manager' ||
        role == 'ADMIN' ||
        role == 'MANAGER';
    }

    function isSellerRole(role) {
      return role == 'seller' ||
        role == 'Seller' ||
        role == 'SELLER';
    }

    function assignedRouteId() {
      return userDoc().data.assigned_route_id;
    }

    function isAdmin() {
      return isActiveUser() && isAdminRole(getUserRole());
    }

    function isSeller() {
      return isActiveUser() && isSellerRole(getUserRole());
    }

    function isOwnDoc(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isBootstrapAdminCreate(userId) {
      return isOwnDoc(userId)
        && !exists(/databases/$(database)/documents/users/$(userId))
        && request.auth.token.email == 'admin@footwear.pk'
        && request.resource.data.role == 'admin'
        && request.resource.data.active == true;
    }

    function isSellerForRoute(routeId) {
      return isSeller() && assignedRouteId() != null && assignedRouteId() == routeId;
    }

    // --- users --------------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwnDoc(userId) || isAdmin();
      allow create: if isAdmin() || isBootstrapAdminCreate(userId) ||
        (
          isOwnDoc(userId) &&
          request.resource.data.role == 'seller' &&
          request.resource.data.active == true
        );
      allow update: if isAdmin() || isOwnDoc(userId);
      allow delete: if isAdmin();
    }

    // --- products -----------------------------------------------------------
    match /products/{productId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- product_variants ---------------------------------------------------
    match /product_variants/{variantId} {
      allow read: if isActiveUser();
      allow create: if isAdmin();
      // Seller can only increment quantity_available (warehouse returns) — prevents depletion
      allow update: if isAdmin() ||
        (
          isSeller() &&
          request.resource.data.quantity_available > resource.data.quantity_available &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity_available', 'updated_at'])
        );
      allow delete: if isAdmin();
    }

    // --- routes -------------------------------------------------------------
    match /routes/{routeId} {
      allow read: if isAdmin() || isSellerForRoute(routeId);
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- customers (consolidates shops and customers) ----
    match /customers/{customerId} {
      allow read: if isAdmin() ||
        (
          isSeller() &&
          resource.data.route_id != null &&
          isSellerForRoute(resource.data.route_id)
        );
      allow create: if isAdmin() ||
        (
          isSeller() &&
          request.resource.data.route_id != null &&
          isSellerForRoute(request.resource.data.route_id)
        ) ||
        (isSeller() && request.resource.data.route_id == null);
      allow update: if isAdmin() || 
        (
          isSeller() &&
          isSellerForRoute(resource.data.route_id)
        ) ||
        (
          // Allow sellers to update ONLY balance+updated_at on customers that
          // have no route assigned (route_id == '' / null).  This covers atomic
          // batch writes from createReturn / updateTransaction / deleteTransaction
          // where the shop was created without a route ("R0" badge).
          isSeller() &&
          (resource.data.route_id == null || resource.data.route_id == '') &&
          assignedRouteId() != null && assignedRouteId() != '' &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['balance', 'updated_at'])
        );
      allow delete: if isAdmin();
    }

    // --- transactions -------------------------------------------------------
    match /transactions/{txId} {
      allow read: if isAdmin() ||
        (
          isSeller() && (
            (resource.data.route_id != null &&
             resource.data.route_id != '' &&
             isSellerForRoute(resource.data.route_id)) ||
            resource.data.created_by == request.auth.uid ||
            (resource.data.shop_id != null &&
             resource.data.shop_id != '' &&
             isSellerForRoute(
               get(/databases/$(database)/documents/customers/$(resource.data.shop_id)).data.route_id
             ))
          )
        );
      allow create: if isAdmin() ||
        (
          isSeller() &&
          request.resource.data.created_by == request.auth.uid &&
          (
            (request.resource.data.route_id != null &&
             request.resource.data.route_id != '' &&
             isSellerForRoute(request.resource.data.route_id)) ||
            (request.resource.data.shop_id != null &&
             request.resource.data.shop_id != '' &&
             isSellerForRoute(
               get(/databases/$(database)/documents/customers/$(request.resource.data.shop_id)).data.route_id
             ))
          )
        );
      allow update: if isAdmin() ||
        (isSeller() && resource.data.created_by == request.auth.uid);
      allow delete: if isAdmin() ||
        (isSeller() && resource.data.created_by == request.auth.uid);
    }

    // --- seller inventory ---------------------------------------------------
    match /seller_inventory/{docId} {
      allow read: if isAdmin() ||
        (isSeller() && resource.data.seller_id == request.auth.uid);
      allow create, delete: if isAdmin();
      // Seller can update quantity_available when executing a sale (stock deduction)
      allow update: if isAdmin() ||
        (isSeller() && resource.data.seller_id == request.auth.uid);
    }

    // --- inventory transactions (audit log for all stock movements) ---------
    match /inventory_transactions/{docId} {
      allow read: if isAdmin() ||
        (isSeller() && resource.data.seller_id == request.auth.uid);
      allow create: if isAdmin() ||
        (
          isSeller() &&
          request.resource.data.seller_id == request.auth.uid &&
          request.resource.data.created_by == request.auth.uid
        );
      allow update, delete: if isAdmin();
    }

    // --- settings -----------------------------------------------------------
    match /settings/{docId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // --- Deny all other paths -----------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
