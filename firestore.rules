rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return isAuthenticated() && userDoc().data.active == true;
    }

    function hasMissingTenantDocumentReadAccess(allowSellers) {
      let userData = userDoc().data;
      let role = userData.get('role', '');
      let tenantId = isSuperAdminRole(role)
        ? userData.get('active_workspace_id', '')
        : userData.get('tenant_id', '');
      let isSelectedSuperAdmin = !isSuperAdminRole(role) ||
        (userData.get('active_workspace_id', '') == tenantId &&
          userData.get('active_workspace_reason', '') is string &&
          userData.get('active_workspace_reason', '').size() >= 10 &&
          userData.get('active_workspace_selected_at', null) is timestamp &&
          userData.get('active_workspace_selected_at', null) >
            request.time - duration.value(8, 'h') &&
          userData.get('active_workspace_selected_at', null) <= request.time);
      return isAuthenticated() &&
        userData.get('active', false) == true &&
        tenantId is string && tenantId != '' && tenantId != '__global__' &&
        isTenantActive(tenantId) && isSelectedSuperAdmin &&
        (isAdminRole(role) ||
          (allowSellers &&
            (isSellerRole(role) || isSupervisorRole(role))));
    }

    function canReadMissingTenantDocument(allowSellers) {
      return resource == null &&
        hasMissingTenantDocumentReadAccess(allowSellers);
    }

    function canReadMissingWorkspaceSettings(docId) {
      let tenantPath = /databases/$(database)/documents/tenants/$(docId);
      return resource == null && isSuperAdmin() &&
        docId is string && docId != '' && docId != '__global__' &&
        !exists(tenantPath);
    }

    function getUserRole() {
      return userDoc().data.role;
    }

    function isAdminRole(role) {
      return role is string &&
        role.matches('(?i)^\\s*(admin|manager|tenant[_-]?admin|super[_-]?admin)\\s*$');
    }

    function isSupervisorRole(role) {
      return role is string && role.matches('(?i)^\\s*supervisor\\s*$');
    }

    function isOperationalRole(role) {
      return isAdminRole(role) || isSupervisorRole(role);
    }

    function isTenantAdminOnlyRole(role) {
      return role is string && role.matches('(?i)^\\s*tenant[_-]?admin\\s*$');
    }
    function isWorkspaceAdminRole(role) {
      return role is string &&
        role.matches('(?i)^\\s*(admin|manager|tenant[_-]?admin)\\s*$');
    }
    function isSuperAdminRole(role) {
      return role is string && role.matches('(?i)^\\s*super[_-]?admin\\s*$');
    }
    function isWorkspaceAssignableRole(role) {
      return role is string &&
        (role == 'supervisor' || role == 'seller');
    }

    function isSuperAdmin() {
      return isActiveUser() && isSuperAdminRole(getUserRole());
    }

    function isTenantActive(tenantId) {
      return tenantId is string && tenantId != '' &&
        (tenantId == '__global__' ||
          get(/databases/$(database)/documents/tenants/$(tenantId)).data.active == true);
    }

    function isConcreteTenantId(tenantId) {
      return tenantId is string && tenantId != '' &&
        tenantId != '__global__';
    }

    function isSuperAdminForSelectedWorkspace(tenantId) {
      return isSuperAdmin() &&
        hasSelectedWorkspaceSupportContext(userDoc().data, tenantId);
    }

    function hasSelectedWorkspaceSupportContext(userData, tenantId) {
      let reason = userData.get('active_workspace_reason', '');
      let selectedAt = userData.get('active_workspace_selected_at', null);
      return userData.get('active_workspace_id', '') == tenantId &&
        reason is string && reason.size() >= 10 &&
        selectedAt is timestamp &&
        selectedAt > request.time - duration.value(8, 'h') &&
        selectedAt <= request.time;
    }

    function supportAccessStartLogMatches(userId, workspaceId, reason, logId) {
      let logPath = /databases/$(database)/documents/platform_access_logs/$(logId);
      let log = getAfter(logPath).data;
      return logId is string && logId.size() > 0 &&
        log.actor_user_id == userId &&
        log.workspace_id == workspaceId &&
        log.event_type == 'workspace_access_started' &&
        log.reason == reason &&
        log.created_at == request.time;
    }

    function isLinkedSupportAccessStartLog(logId) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let userData = getAfter(userPath).data;
      return logId is string && logId.size() > 0 &&
        userData.get('active_workspace_access_log_id', '') == logId &&
        userData.get('active_workspace_id', '') ==
          request.resource.data.workspace_id &&
        userData.get('active_workspace_reason', '') ==
          request.resource.data.reason &&
        userData.get('active_workspace_selected_at', null) ==
          request.resource.data.created_at &&
        request.resource.data.created_at == request.time;
    }

    function hasNewSupportAccessEndLog(logId) {
      let logPath = /databases/$(database)/documents/platform_access_logs/$(logId);
      return logId is string && logId.size() > 0 &&
        !exists(logPath) &&
        existsAfter(logPath);
    }

    function isLinkedSupportAccessEndLog(logId) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let previousUser = get(userPath).data;
      let updatedUser = getAfter(userPath).data;
      let startedLogId = previousUser.get('active_workspace_access_log_id', '');
      return logId is string && logId.size() > 0 &&
        previousUser.get('active_workspace_id', '') ==
          request.resource.data.workspace_id &&
        previousUser.get('active_workspace_reason', '') ==
          request.resource.data.reason &&
        request.resource.data.get('started_log_id', '') == startedLogId &&
        updatedUser.get('last_workspace_access_end_log_id', '') == logId;
    }

    function isSuperAdminRestoringTenant(tenantId) {
      let tenantPath = /databases/$(database)/documents/tenants/$(tenantId);
      return isSuperAdminForSelectedWorkspace(tenantId) &&
        get(tenantPath).data.active == false &&
        getAfter(tenantPath).data.active == true;
    }

    // P0-2 FIX: isAdminForTenant(tenantId) checks if the current user is an
    // admin-tier account that can access this specific tenant's data. Used as
    // the security boundary for all tenant-owned documents: routes, shops,
    // transactions, invoices, products, inventory, notifications, etc.
    function isAdminForTenant(tenantId) {
      let userData = userDoc().data;
      let role = userData.get('role', '');
      let isPlatformAdmin = isSuperAdminRole(role);
      let isAssignedToTenant = userData.get('tenant_id', null) == tenantId ||
        (tenantId == '__global__' &&
          userData.get('tenant_id', null) == null);
      let hasTenantAccess = isPlatformAdmin
        ? hasSelectedWorkspaceSupportContext(userData, tenantId)
        : isAssignedToTenant;
      return isAuthenticated() &&
        userData.get('active', false) == true &&
        isAdminRole(role) &&
        hasTenantAccess &&
        isTenantActive(tenantId);
    }

    function isOperationalForTenant(tenantId) {
      let userData = userDoc().data;
      let role = userData.get('role', '');
      let isPlatformAdmin = isSuperAdminRole(role);
      let isAssignedToTenant = userData.get('tenant_id', null) == tenantId ||
        (tenantId == '__global__' &&
          userData.get('tenant_id', null) == null);
      let hasTenantAccess = isPlatformAdmin
        ? hasSelectedWorkspaceSupportContext(userData, tenantId)
        : isAssignedToTenant;
      return isAuthenticated() &&
        userData.get('active', false) == true &&
        isOperationalRole(role) &&
        hasTenantAccess &&
        isTenantActive(tenantId);
    }

    function isNotificationReaderForTenant(tenantId) {
      return isConcreteTenantId(tenantId) &&
        isOperationalForTenant(tenantId) &&
        !isSuperAdminRole(getUserRole());
    }

    function isNotificationMarkRead() {
      let changedFields = request.resource.data.diff(resource.data)
        .affectedKeys();
      return resource.data.get('read', false) == false &&
        request.resource.data.get('read', false) == true &&
        request.resource.data.get('read_at', null) is timestamp &&
        request.resource.data.read_at == request.time &&
        changedFields.hasOnly(['read', 'read_at']) &&
        changedFields.hasAll(['read', 'read_at']);
    }

    function currentUserTenantId() {
      return isSuperAdminRole(getUserRole())
        ? userDoc().data.active_workspace_id
        : userDoc().data.tenant_id;
    }

    function canAccessTenant(tenantId) {
      return isSuperAdmin() || (
        isActiveUser() &&
        !isSuperAdminRole(getUserRole()) &&
        isAdminRole(getUserRole()) &&
        currentUserTenantId() == tenantId
      );
    }

    function isTenantAdmin() {
      return isActiveUser() && isTenantAdminOnlyRole(getUserRole());
    }

    function isSellerRole(role) {
      return role is string && role.matches('(?i)^\\s*seller\\s*$');
    }

    function assignedRouteIds() {
      return userDoc().data.assigned_route_ids;
    }

    function isSeller() {
      return isActiveUser() && isSellerRole(getUserRole());
    }

    function isOwnDoc(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function selfEmailVerificationMatchesAuthToken(userId) {
      let changedFields =
        request.resource.data.diff(resource.data).affectedKeys();
      return !isOwnDoc(userId) ||
        !changedFields.hasAny(['email_verified']) ||
        request.resource.data.email_verified ==
          request.auth.token.email_verified;
    }

    // S-07: cap document field count (request.resource.data.size() returns
    // field count, NOT byte size). 100 fields is a generous upper bound for
    // any document in this schema.
    function docSizeOk() {
      return request.resource.data.size() < 100;
    }

    function validTenantLifecycleTransition(currentData, nextData) {
      let changed = nextData.diff(currentData).affectedKeys();
      return !changed.hasAny(['active', 'archived_at', 'archived_by']) ||
        (nextData.active == false &&
          nextData.archived_at == request.time &&
          nextData.archived_by == request.auth.uid) ||
        (nextData.active == true &&
          !('archived_at' in nextData) &&
          !('archived_by' in nextData));
    }

    function tenantSeatCounterMatches(tenantData, tenantId, userId, kind) {
      let tenantPath = /databases/$(database)/documents/tenants/$(tenantId);
      let after = getAfter(tenantPath).data;
      let beforeRevision = tenantData.get('seat_count_revision', 0);
      return tenantData.get('active', false) == true &&
        beforeRevision is int &&
        after.get('active', false) == true &&
        after.get('seat_count_revision', null) == beforeRevision + 1 &&
        after.get('seat_change_user_id', '') == userId &&
        after.get('seat_change_kind', '') == kind;
    }

    function validUserSeatTransition(
      userId, currentData, nextData, tenantData
    ) {
      let wasActive = currentData.get('active', false) == true;
      let willBeActive = nextData.get('active', false) == true;
      let tenantId = currentData.get('tenant_id', '');
      return wasActive == willBeActive ||
        (willBeActive &&
          tenantSeatCounterMatches(tenantData, tenantId, userId, 'add')) ||
        (!willBeActive &&
          tenantSeatCounterMatches(tenantData, tenantId, userId, 'remove'));
    }

    function canAdminCreateUserForTenant(tenantId) {
      let actor = userDoc().data;
      let role = actor.get('role', '');
      let isPlatformAdmin = isSuperAdminRole(role);
      return actor.get('active', false) == true &&
        isAdminRole(role) &&
        (isPlatformAdmin
          ? hasSelectedWorkspaceSupportContext(actor, tenantId)
          : actor.get('tenant_id', '') == tenantId);
    }

    function canUpdateTenantSeatCounter(tenantId) {
      let actor = userDoc().data;
      let role = actor.get('role', '');
      let isPlatformAdmin = isSuperAdminRole(role);
      return actor.get('active', false) == true &&
        isAdminRole(role) &&
        resource.data.active == true &&
        request.resource.data.active == true &&
        (isPlatformAdmin
          ? hasSelectedWorkspaceSupportContext(actor, tenantId)
          : actor.get('tenant_id', '') == tenantId);
    }

    function canWorkspaceAdminUpdateUser(userId, currentData, nextData) {
      let actor = userDoc().data;
      let role = actor.get('role', '');
      let tenantId = currentData.get('tenant_id', '');
      let tenantData = get(
        /databases/$(database)/documents/tenants/$(tenantId)
      ).data;
      let changed = nextData.diff(currentData).affectedKeys();
      let isOwner = tenantData.get('owner_user_id', '') == userId;
      let ownerContactUpdate = isOwner &&
        isTenantAdminOnlyRole(currentData.get('role', '')) &&
        userId == request.auth.uid &&
        changed.hasOnly(['display_name', 'phone', 'updated_at']);
      let managedAccountUpdate = !isOwner &&
        !isTenantAdminOnlyRole(currentData.get('role', '')) &&
        !isSuperAdminRole(currentData.get('role', '')) &&
        (isSupervisorRole(currentData.get('role', '')) ||
          isSellerRole(currentData.get('role', ''))) &&
        isWorkspaceAssignableRole(nextData.get('role', '')) &&
        changed.hasOnly([
          'display_name', 'phone', 'role', 'assigned_route_ids',
          'assigned_route_names', 'updated_at'
        ]) &&
        (isSellerRole(nextData.get('role', ''))
          ? nextData.get('assigned_route_ids', []) is list &&
            nextData.get('assigned_route_ids', []).size() > 0
          : nextData.get('assigned_route_ids', []) is list &&
            nextData.get('assigned_route_ids', []).size() == 0);
      return actor.get('active', false) == true &&
        isTenantAdminOnlyRole(role) &&
        actor.get('tenant_id', '') == tenantId &&
        tenantData.get('active', false) == true &&
        nextData.get('tenant_id', '') == tenantId &&
        (ownerContactUpdate ||
          (userId != request.auth.uid && managedAccountUpdate)) &&
        nextData.get('updated_at', null) is timestamp &&
        docSizeOk();
    }

    function canTenantAdminUpdateSupervisorActive(
      userId, currentData, nextData
    ) {
      let actor = userDoc().data;
      let tenantId = currentData.get('tenant_id', '');
      let tenantPath = /databases/$(database)/documents/tenants/$(tenantId);
      let tenantAfter = getAfter(tenantPath).data;
      let changed = nextData.diff(currentData).affectedKeys();
      let seatKind = nextData.get('active', false) ? 'add' : 'remove';
      return actor.get('active', false) == true &&
        isTenantAdminOnlyRole(actor.get('role', '')) &&
        actor.get('tenant_id', '') == tenantId &&
        isSupervisorRole(currentData.get('role', '')) &&
        changed.hasOnly(['active', 'updated_at']) &&
        currentData.get('active', false) != nextData.get('active', false) &&
        nextData.get('active', false) is bool &&
        tenantAfter.get('active', false) == true &&
        tenantAfter.get('seat_change_user_id', '') == userId &&
        tenantAfter.get('seat_change_kind', '') == seatKind &&
        tenantAfter.get('updated_at', null) == request.time &&
        nextData.get('updated_at', null) is timestamp &&
        docSizeOk();
    }

    function canWorkspaceAdminUpdateSeller(userId, currentData, nextData) {
      let actor = userDoc().data;
      let role = actor.get('role', '');
      let tenantId = currentData.get('tenant_id', '');
      let tenantData = get(
        /databases/$(database)/documents/tenants/$(tenantId)
      ).data;
      return actor.get('active', false) == true &&
        isWorkspaceAdminRole(role) &&
        actor.get('tenant_id', '') == tenantId &&
        tenantData.get('active', false) == true &&
        isSellerRole(currentData.get('role', '')) &&
        nextData.get('tenant_id', '') == tenantId &&
        nextData.diff(currentData).affectedKeys().hasOnly([
          'display_name', 'phone', 'active', 'assigned_route_ids',
          'assigned_route_names', 'updated_at'
        ]) &&
        nextData.get('active', false) is bool &&
        validUserSeatTransition(userId, currentData, nextData, tenantData) &&
        docSizeOk();
    }

    function validSeatCounterReconciliation(tenantId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let currentRevision = resource.data.get('seat_count_revision', 0);
      return resource.data.get('active', false) == true &&
        changed.hasOnly([
          'active_user_count', 'max_active_users',
          'seat_count_revision', 'updated_at'
        ]) &&
        changed.hasAll([
          'active_user_count', 'seat_count_revision', 'updated_at'
        ]) &&
        request.resource.data.tenant_id == tenantId &&
        request.resource.data.active_user_count is int &&
        request.resource.data.active_user_count >= 0 &&
        request.resource.data.max_active_users == 10 &&
        request.resource.data.seat_count_revision is int &&
        request.resource.data.seat_count_revision == currentRevision + 1 &&
        request.resource.data.updated_at == request.time &&
        docSizeOk();
    }

    function validTenantSeatCounterUpdate(tenantId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let userId = request.resource.data.get('seat_change_user_id', '');
      let kind = request.resource.data.get('seat_change_kind', '');
      let userPath = /databases/$(database)/documents/users/$(userId);
      let userBefore = exists(userPath) ? get(userPath).data : {};
      let userAfter = existsAfter(userPath) ? getAfter(userPath).data : {};
      let wasActive = userBefore.get('active', false) == true;
      let willBeActive = userAfter.get('active', false) == true;
      let beforeCount = resource.data.get('active_user_count', null);
      let afterCount = request.resource.data.get('active_user_count', null);
      let beforeRevision = resource.data.get('seat_count_revision', 0);
      return changed.hasOnly([
          'active_user_count', 'seat_count_revision',
          'seat_change_user_id', 'seat_change_kind', 'updated_at'
        ]) &&
        changed.hasAll([
          'active_user_count', 'seat_count_revision',
          'seat_change_user_id', 'seat_change_kind', 'updated_at'
        ]) &&
        request.resource.data.tenant_id == tenantId &&
        userId is string && userId != '' &&
        request.resource.data.updated_at == request.time &&
        beforeCount is int && afterCount is int &&
        request.resource.data.seat_count_revision is int &&
        request.resource.data.seat_count_revision == beforeRevision + 1 &&
        request.resource.data.max_active_users == 10 &&
        existsAfter(userPath) &&
        userAfter.get('tenant_id', '') == tenantId &&
        !isSuperAdminRole(userAfter.get('role', '')) &&
        ((kind == 'add' && !wasActive && willBeActive &&
            beforeCount < 10 && afterCount == beforeCount + 1) ||
          (kind == 'remove' && wasActive && !willBeActive &&
            beforeCount > 0 && afterCount == beforeCount - 1));
    }

    function validSeatCounterInitialization(tenantId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !('active_user_count' in resource.data) &&
        changed.hasOnly([
          'active_user_count', 'max_active_users',
          'seat_count_revision', 'plan', 'updated_at'
        ]) &&
        request.resource.data.tenant_id == tenantId &&
        request.resource.data.active_user_count is int &&
        request.resource.data.active_user_count >= 0 &&
        request.resource.data.max_active_users == 10 &&
        request.resource.data.seat_count_revision == 0 &&
        request.resource.data.updated_at == request.time &&
        (!('plan' in resource.data) ||
          request.resource.data.plan == resource.data.plan) &&
        request.resource.data.plan == 'free' &&
        docSizeOk();
    }

    // BUG-02: Sellers may only create cash_in or cash_out transactions.
    // Admin-only types: return, payment, write_off.
    function isValidSellerTransactionType(type) {
      return type == 'cash_in' || type == 'cash_out';
    }

    // Write-rate guard: at least 1 second between writes (prevent rapid-fire)
    function withinWriteRate() {
      return resource == null
        || !('updated_at' in resource.data)
        || request.time > resource.data.updated_at + duration.value(1, 's');
    }

    function notificationIsLinkedToInvoice(notifId) {
      let refId = request.resource.data.ref_id;
      let invoicePath = /databases/$(database)/documents/invoices/$(refId);
      let invoice = get(invoicePath).data;
      return refId is string &&
        refId.size() > 0 &&
        notifId == 'invoice_' + refId &&
        exists(invoicePath) &&
        invoice.get('type', '') == 'sale' &&
        invoice.get('created_by', '') == request.auth.uid &&
        invoice.get('seller_id', '') == request.auth.uid &&
        invoice.get('tenant_id', '') == request.resource.data.tenant_id &&
        invoice.get('shop_id', '') == request.resource.data.shop_id &&
        invoice.get('shop_name', '') == request.resource.data.shop_name &&
        invoice.get('route_id', '') == request.resource.data.route_id &&
        invoice.get('invoice_number', '') ==
          request.resource.data.invoice_number &&
        invoice.get('total', 0) == request.resource.data.amount;
    }

    function notificationIsLinkedToTransaction(notifId) {
      let refId = request.resource.data.ref_id;
      let transactionPath =
        /databases/$(database)/documents/transactions/$(refId);
      let source = get(transactionPath).data;
      return refId is string &&
        refId.size() > 0 &&
        notifId == 'transaction_' + refId &&
        exists(transactionPath) &&
        !('invoice_id' in source) &&
        source.get('created_by', '') == request.auth.uid &&
        source.get('tenant_id', '') == request.resource.data.tenant_id &&
        source.get('shop_id', '') == request.resource.data.shop_id &&
        source.get('shop_name', '') == request.resource.data.shop_name &&
        source.get('route_id', '') == request.resource.data.route_id &&
        source.get('type', '') == request.resource.data.transaction_type &&
        source.get('amount', 0) == request.resource.data.amount;
    }

    function isSellerForRoute(routeId) {
      return isSeller() &&
        isTenantActive(currentUserTenantId()) &&
        routeId in assignedRouteIds();
    }

    function sellerRouteShopCountUpdateIsLinked(routeId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let currentCount = ('total_shops' in resource.data &&
          resource.data.total_shops is number)
        ? resource.data.total_shops
        : 0;
      let shopId = ('last_shop_created_id' in request.resource.data)
        ? request.resource.data.last_shop_created_id
        : '';
      let shopPath = /databases/$(database)/documents/customers/$(shopId);
      return isSeller() &&
        isSellerForRoute(routeId) &&
        resource.data.active == true &&
        resource.data.tenant_id == currentUserTenantId() &&
        request.resource.data.tenant_id == resource.data.tenant_id &&
        changed.hasOnly([
          'total_shops', 'last_shop_created_id', 'updated_at'
        ]) &&
        changed.hasAll([
          'total_shops', 'last_shop_created_id', 'updated_at'
        ]) &&
        request.resource.data.updated_at == request.time &&
        request.resource.data.total_shops is number &&
        request.resource.data.total_shops == currentCount + 1 &&
        shopId is string &&
        shopId != '' &&
        !exists(shopPath) &&
        existsAfter(shopPath) &&
        getAfter(shopPath).data.tenant_id == resource.data.tenant_id &&
        getAfter(shopPath).data.route_id == routeId &&
        getAfter(shopPath).data.created_by == request.auth.uid &&
        getAfter(shopPath).data.active == true;
    }

    // Returns the route_id for a shop/customer document.
    // Using a single get() avoids an extra exists() read on every check.
    function shopRouteId(shopId) {
      return get(/databases/$(database)/documents/customers/$(shopId)).data.route_id;
    }

    // True when the seller owns the route the given shop belongs to.
    function isSellerForShop(shopId) {
      return isSeller() &&
        shopId is string &&
        shopId != '' &&
        shopRouteId(shopId) in assignedRouteIds() &&
        isTenantActive(shopTenantId(shopId)) &&
        shopTenantId(shopId) == currentUserTenantId();
    }

    function sellerInvoiceScopeMatches(invoiceData) {
      let userData = userDoc().data;
      let role = userData.get('role', '');
      let tenantId = invoiceData.get('tenant_id', '');
      let routeId = invoiceData.get('route_id', '');
      let shopId = invoiceData.get('shop_id', '');
      let shop = get(
        /databases/$(database)/documents/customers/$(shopId)
      ).data;
      return isAuthenticated() &&
        userData.get('active', false) == true &&
        isSellerRole(role) &&
        invoiceData.get('created_by', '') == request.auth.uid &&
        invoiceData.get('seller_id', '') == request.auth.uid &&
        tenantId is string && tenantId != '' &&
        tenantId == userData.get('tenant_id', '') &&
        isTenantActive(tenantId) &&
        routeId is string && routeId != '' &&
        userData.get('assigned_route_ids', []) is list &&
        routeId in userData.get('assigned_route_ids', []) &&
        shopId is string && shopId != '' &&
        shop is map &&
        shop.get('tenant_id', '') == tenantId &&
        shop.get('route_id', '') == routeId;
    }

    function shopTenantId(shopId) {
      return get(/databases/$(database)/documents/customers/$(shopId)).data.tenant_id;
    }

    // True when a transaction doc belongs to the seller's assigned route.
    // Checks route_id field first (fast, no cross-doc lookup);
    // falls back to shop_id for docs missing route_id.
    function isSellerRouteTransaction() {
      return isSeller() && (
        (resource.data.route_id != null &&
         resource.data.route_id != '' &&
        isSellerForRoute(resource.data.route_id) &&
        resource.data.tenant_id == currentUserTenantId()) ||
        (resource.data.shop_id != null &&
         resource.data.shop_id != '' &&
        isSellerForShop(resource.data.shop_id) &&
        resource.data.tenant_id == currentUserTenantId())
      );
    }

    // Same as isSellerRouteTransaction() but for incoming writes.
    function requestIsSellerRouteTransaction() {
      return isSeller() && (
        (request.resource.data.route_id != null &&
         request.resource.data.route_id != '' &&
        isSellerForRoute(request.resource.data.route_id) &&
        request.resource.data.tenant_id == currentUserTenantId()) ||
        (request.resource.data.shop_id != null &&
         request.resource.data.shop_id != '' &&
        isSellerForShop(request.resource.data.shop_id) &&
        request.resource.data.tenant_id == currentUserTenantId())
      );
    }

    // Validates an allowed transaction type value
    function isValidTransactionType(type) {
      return type is string &&
        (type == 'cash_out' || type == 'cash_in' || type == 'return' ||
         type == 'payment' || type == 'write_off');
    }

    function isValidCreditNoteLink(invoiceId) {
      let invoicePath = /databases/$(database)/documents/invoices/$(request.resource.data.linked_invoice_id);
      let original = get(invoicePath).data;
      let originalAfter = getAfter(invoicePath).data;
      let creditedBefore = ('credit_note_total' in original &&
          original.credit_note_total is number)
        ? original.credit_note_total
        : 0;
      return request.resource.data.linked_invoice_id is string &&
        request.resource.data.linked_invoice_id != '' &&
        exists(invoicePath) &&
        original.tenant_id == request.resource.data.tenant_id &&
        original.shop_id == request.resource.data.shop_id &&
        original.type == 'sale' &&
        original.status != 'void' &&
        request.resource.data.total <= original.total &&
        originalAfter.credit_note_total is number &&
        originalAfter.credit_note_total == creditedBefore + request.resource.data.total &&
        originalAfter.latest_credit_note_invoice_id == invoiceId &&
        originalAfter.credit_note_total <= original.total;
    }

    function hasValidTransactionEditHistory() {
      return 'edit_history' in request.resource.data &&
        request.resource.data.edit_history is list &&
        request.resource.data.edit_history.size() ==
          (('edit_history' in resource.data && resource.data.edit_history is list)
            ? resource.data.edit_history.size() + 1
            : 1) &&
        (!('edit_history' in resource.data) ||
          (resource.data.edit_history is list &&
            request.resource.data.edit_history.hasAll(resource.data.edit_history))) &&
        request.resource.data.edit_history[
          request.resource.data.edit_history.size() - 1
        ].previous_amount == resource.data.amount &&
        request.resource.data.edit_history[
          request.resource.data.edit_history.size() - 1
        ].previous_type == resource.data.type &&
        request.resource.data.edit_history[
          request.resource.data.edit_history.size() - 1
        ].previous_created_at ==
          (('created_at' in resource.data) ? resource.data.created_at : null) &&
        request.resource.data.edit_history[
          request.resource.data.edit_history.size() - 1
        ].changed_by == request.auth.uid &&
        request.resource.data.edit_history[
          request.resource.data.edit_history.size() - 1
        ].reason is string &&
        request.resource.data.edit_history[
          request.resource.data.edit_history.size() - 1
        ].reason.size() >= 10 &&
        request.resource.data.edit_history[
          request.resource.data.edit_history.size() - 1
        ].changed_at is timestamp;
    }

    function isValidInventoryTransactionType(type) {
      return type is string &&
        (type == 'transfer_out' ||
         type == 'return_to_warehouse' ||
         type == 'return_from_shop' ||
         type == 'stock_adjustment');
    }

    function sellerInventoryCreateMatchesWarehouse() {
      let tenantId = request.resource.data.tenant_id;
      let sellerPath = /databases/$(database)/documents/users/$(request.resource.data.seller_id);
      let variantPath = /databases/$(database)/documents/product_variants/$(request.resource.data.variant_id);
      let seller = get(sellerPath).data;
      let variantBefore = get(variantPath).data;
      let variantAfter = getAfter(variantPath).data;
      return request.resource.data.seller_id is string &&
        request.resource.data.seller_id != '' &&
        request.resource.data.product_id is string &&
        request.resource.data.product_id != '' &&
        request.resource.data.variant_id is string &&
        request.resource.data.variant_id != '' &&
        request.resource.data.quantity_available is int &&
        request.resource.data.quantity_available > 0 &&
        request.resource.data.active == true &&
        seller is map &&
        seller.get('active', false) == true &&
        seller.get('tenant_id', '') == tenantId &&
        (isSellerRole(seller.get('role', '')) ||
          isOperationalRole(seller.get('role', ''))) &&
        variantBefore is map &&
        variantAfter is map &&
        variantBefore.get('tenant_id', '') == tenantId &&
        variantAfter.get('tenant_id', '') == tenantId &&
        variantBefore.get('product_id', '') == request.resource.data.product_id &&
        variantAfter.get('product_id', '') == request.resource.data.product_id &&
        variantBefore.get('quantity_available', -1) is number &&
        variantAfter.get('quantity_available', -1) is number &&
        variantBefore.quantity_available - variantAfter.quantity_available ==
          request.resource.data.quantity_available;
    }

    function sellerInventoryDecreaseMatchesInvoice(docId) {
      let invoiceId = request.resource.data.last_sale_invoice_id;
      let invoicePath = /databases/$(database)/documents/invoices/$(invoiceId);
      let invoiceData = getAfter(invoicePath).data;
      return invoiceId is string && invoiceId != '' &&
        !exists(invoicePath) && existsAfter(invoicePath) &&
        invoiceData.type == 'sale' &&
        invoiceData.created_by == request.auth.uid &&
        invoiceData.seller_id == request.auth.uid &&
        invoiceData.tenant_id == currentUserTenantId() &&
        invoiceData.seller_inventory_deductions[docId] is number &&
        invoiceData.seller_inventory_deductions[docId] ==
          resource.data.quantity_available - request.resource.data.quantity_available;
    }

    // Writes store canonical role values; role-read helpers accept legacy aliases.
    function isValidRole(role) {
      return role in [
        'admin', 'supervisor', 'tenant_admin', 'super_admin', 'seller'
      ];
    }

    function currentUserSettingsDocId() {
      return isActiveUser() &&
        userDoc().data.tenant_id is string &&
        userDoc().data.tenant_id != '' ? userDoc().data.tenant_id : '__global__';
    }

    function requiresSellerTransactionEditApproval() {
      return exists(/databases/$(database)/documents/settings/$(currentUserSettingsDocId())) &&
        get(/databases/$(database)/documents/settings/$(currentUserSettingsDocId()))
          .data.require_admin_approval_for_seller_transaction_edits == true;
    }

    function sellerInvoiceBalanceMatches(shopId, transactionData, transactionId) {
      let invoicePath = /databases/$(database)/documents/invoices/$(transactionData.invoice_id);
      let invoiceData = getAfter(invoicePath).data;
      let paymentId = invoiceData.get('payment_transaction_id', '');
      let paymentPath = /databases/$(database)/documents/transactions/$(paymentId);
      let paymentData = getAfter(paymentPath).data;
      return !exists(invoicePath) &&
        existsAfter(invoicePath) &&
        transactionData.type == 'cash_out' &&
        invoiceData.type == 'sale' &&
        invoiceData.shop_id == shopId &&
        invoiceData.sale_transaction_id == transactionId &&
        invoiceData.tenant_id == currentUserTenantId() &&
        invoiceData.total is number &&
        invoiceData.amount_received is number &&
        transactionData.amount == invoiceData.total &&
        (
          (invoiceData.amount_received == 0 &&
            !('payment_transaction_id' in invoiceData)) ||
          (invoiceData.amount_received > 0 &&
            paymentId is string && paymentId != '' &&
            !exists(paymentPath) && existsAfter(paymentPath) &&
            paymentData.type == 'cash_in' &&
            paymentData.amount == invoiceData.amount_received &&
            paymentData.invoice_id == transactionData.invoice_id &&
            paymentData.shop_id == shopId &&
            paymentData.route_id == transactionData.route_id &&
            paymentData.tenant_id == currentUserTenantId() &&
            paymentData.created_by == request.auth.uid)
        ) &&
        request.resource.data.balance >= resource.data.balance +
          invoiceData.total - invoiceData.amount_received - 0.01 &&
        request.resource.data.balance <= resource.data.balance +
          invoiceData.total - invoiceData.amount_received + 0.01;
    }

    function saleInvoiceIsLinked(invoiceId) {
      let saleId = request.resource.data.sale_transaction_id;
      let salePath = /databases/$(database)/documents/transactions/$(saleId);
      let shopPath = /databases/$(database)/documents/customers/$(request.resource.data.shop_id);
      let tenantId = request.resource.data.tenant_id;
      let sequence = request.resource.data.invoice_sequence;
      let sale = getAfter(salePath).data;
      let shop = getAfter(shopPath).data;
      return saleId is string && saleId != '' &&
        invoiceSequenceIsLinked(tenantId, sequence, invoiceId) &&
        !exists(salePath) && existsAfter(salePath) &&
        sale.type == 'cash_out' &&
        sale.amount == request.resource.data.total &&
        sale.invoice_id == invoiceId &&
        sale.shop_id == request.resource.data.shop_id &&
        sale.route_id == request.resource.data.route_id &&
        shop is map && shop.last_transaction_id == saleId;
    }

    function invoiceSequenceIsLinked(tenantId, sequence, invoiceId) {
      let settingsPath = /databases/$(database)/documents/settings/$(tenantId);
      let settingsBefore = get(settingsPath).data;
      let settingsAfter = getAfter(settingsPath).data;
      return isConcreteTenantId(tenantId) &&
        sequence is int && sequence > 0 &&
        settingsBefore is map && settingsAfter is map &&
        ((settingsBefore.get('last_invoice_number', null) is number &&
            sequence == settingsBefore.last_invoice_number + 1) ||
          (!('last_invoice_number' in settingsBefore) && sequence == 1)) &&
        settingsAfter.last_invoice_number == sequence &&
        settingsAfter.last_invoice_id == invoiceId;
    }

    function invoiceCounterUpdateIsLinked(tenantId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let sequence = request.resource.data.last_invoice_number;
      let invoiceId = request.resource.data.last_invoice_id;
      let invoicePath = /databases/$(database)/documents/invoices/$(invoiceId);
      let invoice = getAfter(invoicePath).data;
      return isConcreteTenantId(tenantId) &&
        changed.hasOnly(['last_invoice_number', 'last_invoice_id']) &&
        changed.hasAll(['last_invoice_number', 'last_invoice_id']) &&
        sequence is int &&
        ((resource.data.get('last_invoice_number', null) is number &&
            sequence == resource.data.last_invoice_number + 1) ||
          (!('last_invoice_number' in resource.data) && sequence == 1)) &&
        invoiceId is string && invoiceId != '' &&
        !exists(invoicePath) && existsAfter(invoicePath) &&
        invoice.tenant_id == tenantId &&
        invoice.invoice_sequence == sequence &&
        invoice.created_by == request.auth.uid &&
        invoice.type in ['sale', 'credit_note'];
    }

    function sellerCashReceiptBalanceMatches(shopId, transactionId, transactionData) {
      let invoicePath = /databases/$(database)/documents/invoices/$(transactionData.invoice_id);
      let invoiceData = getAfter(invoicePath).data;
      return !exists(invoicePath) &&
        existsAfter(invoicePath) &&
        transactionData.type == 'cash_in' &&
        invoiceData.type == 'cash_receipt' &&
        invoiceData.shop_id == shopId &&
        invoiceData.route_id == transactionData.route_id &&
        invoiceData.tenant_id == currentUserTenantId() &&
        invoiceData.created_by == request.auth.uid &&
        invoiceData.cash_receipt_transaction_id == transactionId &&
        invoiceData.total is number &&
        invoiceData.amount_received == invoiceData.total &&
        transactionData.amount == invoiceData.total &&
        request.resource.data.balance >= resource.data.balance -
          invoiceData.total - 0.01 &&
        request.resource.data.balance <= resource.data.balance -
          invoiceData.total + 0.01;
    }

    function sellerCashReceiptIsLinked(invoiceId) {
      let transactionId = request.resource.data.cash_receipt_transaction_id;
      let transactionPath = /databases/$(database)/documents/transactions/$(transactionId);
      let transactionData = getAfter(transactionPath).data;
      let shopPath = /databases/$(database)/documents/customers/$(request.resource.data.shop_id);
      let shopAfter = getAfter(shopPath).data;
      let settingsPath = /databases/$(database)/documents/settings/$(request.resource.data.tenant_id);
      let settingsBefore = get(settingsPath).data;
      let settingsAfter = getAfter(settingsPath).data;
      let sequence = request.resource.data.cash_receipt_sequence;
      return transactionId is string && transactionId != '' &&
        !exists(transactionPath) && existsAfter(transactionPath) &&
        sequence is int && sequence > 0 &&
        settingsBefore is map && settingsAfter is map &&
        ((('last_cash_receipt_number' in settingsBefore) &&
            settingsBefore.last_cash_receipt_number is int &&
            sequence == settingsBefore.last_cash_receipt_number + 1) ||
          (!('last_cash_receipt_number' in settingsBefore) && sequence == 1)) &&
        settingsAfter.last_cash_receipt_number == sequence &&
        transactionData.type == 'cash_in' &&
        transactionData.amount == request.resource.data.total &&
        transactionData.invoice_id == invoiceId &&
        transactionData.shop_id == request.resource.data.shop_id &&
        transactionData.route_id == request.resource.data.route_id &&
        transactionData.tenant_id == request.resource.data.tenant_id &&
        transactionData.created_by == request.auth.uid &&
        shopAfter is map && shopAfter.last_transaction_id == transactionId;
    }

    function creditNoteIsLinked(invoiceId) {
      let transactionId = request.resource.data.return_transaction_id;
      let transactionPath = /databases/$(database)/documents/transactions/$(transactionId);
      let transactionData = getAfter(transactionPath).data;
      let shopPath = /databases/$(database)/documents/customers/$(request.resource.data.shop_id);
      let shopAfter = getAfter(shopPath).data;
      return transactionId is string && transactionId != '' &&
        invoiceSequenceIsLinked(
          request.resource.data.tenant_id,
          request.resource.data.invoice_sequence,
          invoiceId
        ) &&
        !exists(transactionPath) && existsAfter(transactionPath) &&
        transactionData.type == 'return' &&
        transactionData.amount == request.resource.data.total &&
        transactionData.invoice_id == invoiceId &&
        transactionData.shop_id == request.resource.data.shop_id &&
        transactionData.route_id == request.resource.data.route_id &&
        transactionData.tenant_id == request.resource.data.tenant_id &&
        transactionData.created_by == request.auth.uid &&
        shopAfter is map && shopAfter.last_transaction_id == transactionId;
    }

    function shopBalanceChangedBy(delta) {
      return request.resource.data.balance >= resource.data.balance + delta - 0.01 &&
        request.resource.data.balance <= resource.data.balance + delta + 0.01;
    }

    function adminSalePaymentIsLinked(invoiceId, invoiceData) {
      let paymentId = invoiceData.get('payment_transaction_id', '');
      let paymentPath = /databases/$(database)/documents/transactions/$(paymentId);
      let payment = getAfter(paymentPath).data;
      return (invoiceData.amount_received == 0 &&
          !('payment_transaction_id' in invoiceData)) ||
        (invoiceData.amount_received > 0 &&
          paymentId is string && paymentId != '' &&
          !exists(paymentPath) && existsAfter(paymentPath) &&
          payment.type == 'cash_in' &&
          payment.amount == invoiceData.amount_received &&
          payment.invoice_id == invoiceId &&
          payment.shop_id == invoiceData.shop_id &&
          payment.route_id == invoiceData.route_id);
    }

    function adminNewInvoiceBalanceMatches(shopId, transactionId, transactionData, invoiceData) {
      return invoiceData.shop_id == shopId &&
        invoiceData.tenant_id == resource.data.tenant_id &&
        transactionData.route_id == invoiceData.route_id &&
        ((invoiceData.type == 'sale' && transactionData.type == 'cash_out' &&
            invoiceData.sale_transaction_id == transactionId &&
            transactionData.amount == invoiceData.total &&
            invoiceData.amount_received is number &&
            adminSalePaymentIsLinked(transactionData.invoice_id, invoiceData) &&
            shopBalanceChangedBy(invoiceData.total - invoiceData.amount_received)) ||
          (invoiceData.type == 'cash_receipt' && transactionData.type == 'cash_in' &&
            invoiceData.cash_receipt_transaction_id == transactionId &&
            transactionData.amount == invoiceData.total &&
            shopBalanceChangedBy(-invoiceData.total)) ||
          ((invoiceData.type == 'credit_note' || invoiceData.type == 'return') &&
            transactionData.type == 'return' &&
            transactionData.amount == invoiceData.total &&
            shopBalanceChangedBy(-invoiceData.total)));
    }

    function adminUpdatedInvoiceBalanceMatches(transactionData, invoiceBefore, invoiceAfter) {
      return transactionData.route_id == invoiceBefore.route_id &&
        invoiceAfter.route_id == invoiceBefore.route_id &&
        ((invoiceBefore.type == 'sale' && invoiceAfter.status == 'paid' &&
            transactionData.type == 'cash_in' &&
            invoiceAfter.amount_received == invoiceAfter.total &&
            invoiceAfter.outstanding_amount == 0 &&
            transactionData.amount == invoiceBefore.total - invoiceBefore.amount_received &&
            shopBalanceChangedBy(-transactionData.amount)) ||
          (invoiceBefore.type == 'sale' && invoiceAfter.status == 'void' &&
            (transactionData.type == 'return' || transactionData.type == 'cash_out') &&
            transactionData.amount == (transactionData.type == 'return'
              ? invoiceBefore.total
              : invoiceBefore.amount_received) &&
            shopBalanceChangedBy(-(invoiceBefore.total - invoiceBefore.amount_received))) ||
          (invoiceBefore.type != 'sale' && invoiceAfter.status == 'void' &&
            transactionData.type == 'cash_out' &&
            transactionData.amount == invoiceBefore.total &&
            shopBalanceChangedBy(invoiceBefore.total)));
    }

    function adminShopFinancialUpdateIsLinked(shopId) {
      let transactionId = request.resource.data.last_transaction_id;
      let transactionPath = /databases/$(database)/documents/transactions/$(transactionId);
      let transactionData = getAfter(transactionPath).data;
      let invoiceId = transactionData is map
        ? transactionData.get('invoice_id', '')
        : '';
      let invoicePath = /databases/$(database)/documents/invoices/$(invoiceId);
      let invoiceBefore = get(invoicePath).data;
      let invoiceAfter = getAfter(invoicePath).data;
      return transactionId is string && transactionId != '' &&
        transactionData is map &&
        transactionData.shop_id == shopId &&
        transactionData.tenant_id == resource.data.tenant_id &&
        transactionData.created_by == request.auth.uid &&
        transactionData.amount is number && transactionData.amount > 0 &&
        request.resource.data.last_transaction_type == transactionData.type &&
        request.resource.data.last_transaction_amount == transactionData.amount &&
        (
          (!('invoice_id' in transactionData) &&
            (transactionData.type == 'cash_in' ||
              transactionData.type == 'cash_out') &&
            shopBalanceChangedBy(transactionData.type == 'cash_out'
              ? transactionData.amount
              : -transactionData.amount)) ||
          (!('invoice_id' in transactionData) &&
            transactionData.type == 'write_off' &&
            resource.data.get('bad_debt', false) != true &&
            resource.data.balance == transactionData.amount &&
            request.resource.data.bad_debt == true &&
            request.resource.data.bad_debt_amount == transactionData.amount &&
            request.resource.data.balance == 0) ||
          (invoiceId is string && invoiceId != '' &&
            (exists(invoicePath)
              ? (invoiceBefore is map && invoiceAfter is map &&
                invoiceBefore.shop_id == shopId &&
                invoiceAfter.shop_id == shopId &&
                invoiceBefore.tenant_id == resource.data.tenant_id &&
                invoiceAfter.tenant_id == resource.data.tenant_id &&
                adminUpdatedInvoiceBalanceMatches(
                  transactionData,
                  invoiceBefore,
                  invoiceAfter
                ))
              : (invoiceAfter is map &&
                existsAfter(invoicePath) &&
                adminNewInvoiceBalanceMatches(
                  shopId,
                  transactionId,
                  transactionData,
                  invoiceAfter
                ))))
        );
    }

    function shopBalanceMatchesDataDelta(shopBefore, shopAfter, delta) {
      return shopBefore is map && shopAfter is map &&
        shopBefore.balance is number && shopAfter.balance is number &&
        shopAfter.balance >= shopBefore.balance + delta - 0.01 &&
        shopAfter.balance <= shopBefore.balance + delta + 0.01;
    }

    function transactionCreateShopMatches(txData, shopBefore, shopAfter) {
      return txData.created_by == request.auth.uid &&
        txData.shop_id is string && txData.shop_id != '' &&
        txData.route_id is string && txData.route_id != '' &&
        txData.tenant_id is string &&
        shopBefore is map && shopAfter is map &&
        shopBefore.tenant_id == txData.tenant_id &&
        shopAfter.tenant_id == txData.tenant_id &&
        shopBefore.route_id == txData.route_id &&
        shopAfter.route_id == txData.route_id &&
        shopBefore.balance is number && shopAfter.balance is number &&
        shopAfter.last_transaction_id is string &&
        shopAfter.last_transaction_id !=
          shopBefore.get('last_transaction_id', '');
    }

    function standaloneTransactionCreateIsLinked(txId, txData, shopBefore, shopAfter) {
      let cashDelta = txData.type == 'cash_out'
        ? txData.amount
        : -txData.amount;
      return shopAfter.last_transaction_id == txId &&
        shopAfter.last_transaction_type == txData.type &&
        shopAfter.last_transaction_amount == txData.amount &&
        (
          (txData.type in ['cash_in', 'cash_out'] &&
            shopBalanceMatchesDataDelta(shopBefore, shopAfter, cashDelta)) ||
          (txData.type == 'write_off' &&
            shopBefore.get('bad_debt', false) != true &&
            shopBefore.balance == txData.amount &&
            shopAfter.bad_debt == true &&
            shopAfter.bad_debt_amount == txData.amount &&
            shopAfter.balance == 0)
        );
    }

    function newInvoiceTransactionIsLinked(
      txId,
      txData,
      invoiceData,
      shopBefore,
      shopAfter
    ) {
      let saleCashOut = invoiceData.type == 'sale' &&
        txData.type == 'cash_out' &&
        invoiceData.sale_transaction_id == txId &&
        txData.amount == invoiceData.total;
      let saleCashIn = invoiceData.type == 'sale' &&
        txData.type == 'cash_in' &&
        invoiceData.amount_received > 0 &&
        invoiceData.payment_transaction_id == txId &&
        txData.amount == invoiceData.amount_received;
      let cashReceipt = invoiceData.type == 'cash_receipt' &&
        txData.type == 'cash_in' &&
        invoiceData.cash_receipt_transaction_id == txId &&
        txData.amount == invoiceData.total;
      let creditNote = invoiceData.type in ['credit_note', 'return'] &&
        txData.type == 'return' &&
        invoiceData.return_transaction_id == txId &&
        txData.amount == invoiceData.total;
      let expectedLastType = invoiceData.type == 'sale'
        ? 'cash_out'
        : (invoiceData.type == 'cash_receipt' ? 'cash_in' : 'return');
      let balanceDelta = invoiceData.type == 'sale'
        ? invoiceData.total - invoiceData.amount_received
        : -invoiceData.total;
      let expectedLastId = invoiceData.type == 'sale'
        ? invoiceData.sale_transaction_id
        : txId;
      return invoiceData is map &&
        invoiceData.created_by == request.auth.uid &&
        invoiceData.total is number && invoiceData.total > 0 &&
        invoiceData.amount_received is number &&
        (saleCashOut || saleCashIn || cashReceipt || creditNote) &&
        expectedLastId is string &&
        expectedLastId != shopBefore.get('last_transaction_id', '') &&
        shopAfter.last_transaction_id == expectedLastId &&
        shopAfter.last_transaction_type == expectedLastType &&
        shopAfter.last_transaction_amount == invoiceData.total &&
        shopBalanceMatchesDataDelta(shopBefore, shopAfter, balanceDelta);
    }

    function updatedInvoiceTransactionIsLinked(
      txId,
      txData,
      invoiceBefore,
      invoiceAfter,
      shopBefore,
      shopAfter
    ) {
      let invoiceTotal = invoiceBefore.total;
      let amountReceived = invoiceBefore.get('amount_received', 0);
      let paid = invoiceBefore.type == 'sale' &&
        invoiceBefore.status != 'paid' &&
        invoiceAfter.status == 'paid' &&
        txData.type == 'cash_in' &&
        invoiceAfter.amount_received == invoiceAfter.total &&
        invoiceAfter.outstanding_amount == 0 &&
        txData.amount == invoiceTotal - amountReceived &&
        shopAfter.last_transaction_id == txId &&
        shopBalanceMatchesDataDelta(shopBefore, shopAfter, -txData.amount);
      let saleVoid = invoiceBefore.type == 'sale' &&
        invoiceBefore.status != 'void' &&
        invoiceAfter.status == 'void' &&
        txData.type in ['return', 'cash_out'] &&
        txData.amount == (txData.type == 'return'
          ? invoiceTotal
          : amountReceived) &&
        shopBalanceMatchesDataDelta(
          shopBefore,
          shopAfter,
          -(invoiceTotal - amountReceived)
        ) &&
        (shopAfter.last_transaction_id == txId ||
          (txData.type == 'return' &&
            amountReceived > 0 &&
            shopAfter.last_transaction_type == 'cash_out' &&
            shopAfter.last_transaction_amount == amountReceived));
      let otherVoid = invoiceBefore.type != 'sale' &&
        invoiceBefore.status != 'void' &&
        invoiceAfter.status == 'void' &&
        txData.type == 'cash_out' &&
        txData.amount == invoiceTotal &&
        shopAfter.last_transaction_id == txId &&
        shopBalanceMatchesDataDelta(shopBefore, shopAfter, invoiceTotal);
      return invoiceBefore is map && invoiceAfter is map &&
        invoiceBefore.shop_id == txData.shop_id &&
        invoiceAfter.shop_id == txData.shop_id &&
        invoiceBefore.route_id == txData.route_id &&
        invoiceAfter.route_id == txData.route_id &&
        invoiceBefore.tenant_id == txData.tenant_id &&
        invoiceAfter.tenant_id == txData.tenant_id &&
        invoiceTotal is number && amountReceived is number &&
        invoiceAfter.total == invoiceTotal &&
        (paid || saleVoid || otherVoid);
    }

    function invoiceTransactionCreateIsLinked(
      txId,
      txData,
      shopBefore,
      shopAfter
    ) {
      let invoiceId = txData.get('invoice_id', '');
      let invoicePath = /databases/$(database)/documents/invoices/$(invoiceId);
      let invoiceBefore = get(invoicePath).data;
      let invoiceAfter = getAfter(invoicePath).data;
      return invoiceId is string && invoiceId != '' &&
        (exists(invoicePath)
          ? (invoiceBefore is map && invoiceAfter is map &&
            updatedInvoiceTransactionIsLinked(
              txId,
              txData,
              invoiceBefore,
              invoiceAfter,
              shopBefore,
              shopAfter
            ))
          : (invoiceAfter is map &&
            existsAfter(invoicePath) &&
            newInvoiceTransactionIsLinked(
              txId,
              txData,
              invoiceAfter,
              shopBefore,
              shopAfter
            )));
    }

    function invoiceSettlementUpdateIsLinked(invoiceId) {
      let paymentId = request.resource.data.get(
        'latest_payment_transaction_id',
        '__missing__'
      );
      let paymentPath = /databases/$(database)/documents/transactions/$(paymentId);
      let payment = getAfter(paymentPath).data;
      let shopPath = /databases/$(database)/documents/customers/$(resource.data.shop_id);
      let shopBefore = get(shopPath).data;
      let shopAfter = getAfter(shopPath).data;
      let oldPaymentIds = resource.data.get('payment_transaction_ids', []);
      let newPaymentIds = request.resource.data.get('payment_transaction_ids', []);
      let oldAmountReceived = resource.data.get('amount_received', 0);
      return resource.data.type == 'sale' &&
        resource.data.status != 'paid' &&
        request.resource.data.status == 'paid' &&
        resource.data.total is number &&
        oldAmountReceived is number &&
        request.resource.data.amount_received == resource.data.total &&
        request.resource.data.outstanding_amount == 0 &&
        paymentId is string && paymentId != '__missing__' &&
        paymentId != resource.data.get('latest_payment_transaction_id', '') &&
        oldPaymentIds is list && newPaymentIds is list &&
        newPaymentIds.size() == oldPaymentIds.size() + 1 &&
        newPaymentIds.hasAll(oldPaymentIds) &&
        newPaymentIds.hasAny([paymentId]) &&
        !exists(paymentPath) && existsAfter(paymentPath) &&
        payment is map &&
        payment.type == 'cash_in' &&
        payment.amount == resource.data.total - oldAmountReceived &&
        payment.invoice_id == invoiceId &&
        payment.shop_id == resource.data.shop_id &&
        payment.route_id == resource.data.route_id &&
        payment.tenant_id == resource.data.tenant_id &&
        payment.created_by == request.auth.uid &&
        shopAfter is map &&
        shopAfter.last_transaction_id == paymentId &&
        shopAfter.last_transaction_type == 'cash_in' &&
        shopAfter.last_transaction_amount == payment.amount &&
        shopBalanceMatchesDataDelta(shopBefore, shopAfter, -payment.amount);
    }

    function invoicePaidStatusRepairIsValid() {
      let oldPaymentIds = resource.data.get('payment_transaction_ids', []);
      let newPaymentIds = request.resource.data.get('payment_transaction_ids', []);
      return resource.data.type == 'sale' &&
        resource.data.status != 'paid' &&
        request.resource.data.status == 'paid' &&
        resource.data.total is number &&
        resource.data.get('amount_received', 0) == resource.data.total &&
        request.resource.data.amount_received == resource.data.amount_received &&
        request.resource.data.outstanding_amount == 0 &&
        oldPaymentIds is list && newPaymentIds is list &&
        newPaymentIds == oldPaymentIds &&
        request.resource.data.get(
            'latest_payment_transaction_id',
            ''
        ) == resource.data.get('latest_payment_transaction_id', '');
    }

    function invoiceVoidUpdateIsLinked(invoiceId) {
      let reversalId = request.resource.data.get(
        'void_reversal_transaction_id',
        '__missing__'
      );
      let reversalPath = /databases/$(database)/documents/transactions/$(reversalId);
      let reversal = getAfter(reversalPath).data;
      let shopPath = /databases/$(database)/documents/customers/$(resource.data.shop_id);
      let shopBefore = get(shopPath).data;
      let shopAfter = getAfter(shopPath).data;
      let total = resource.data.total;
      let amountReceived = resource.data.get('amount_received', 0);
      let expectedType = resource.data.type == 'sale' ? 'return' : 'cash_out';
      let expectedBalanceDelta = resource.data.type == 'sale'
        ? -(total - amountReceived)
        : total;
      return resource.data.status != 'void' &&
        request.resource.data.status == 'void' &&
        total is number && amountReceived is number &&
        request.resource.data.get('credit_note_total', 0) ==
          resource.data.get('credit_note_total', 0) &&
        reversalId is string && reversalId != '__missing__' &&
        reversalId != resource.data.get('void_reversal_transaction_id', '') &&
        !exists(reversalPath) && existsAfter(reversalPath) &&
        reversal is map &&
        reversal.type == expectedType &&
        reversal.amount == total &&
        reversal.invoice_id == invoiceId &&
        reversal.voided == true &&
        reversal.voided_invoice_id == invoiceId &&
        reversal.tenant_id == resource.data.tenant_id &&
        reversal.shop_id == resource.data.shop_id &&
        reversal.route_id == resource.data.route_id &&
        reversal.created_by == request.auth.uid &&
        shopBalanceMatchesDataDelta(
            shopBefore,
            shopAfter,
            expectedBalanceDelta
        );
    }

    function invoiceCreditNoteCreateUpdateIsLinked(invoiceId) {
      let creditId = request.resource.data.get(
        'latest_credit_note_invoice_id',
        '__missing__'
      );
      let creditPath = /databases/$(database)/documents/invoices/$(creditId);
      let credit = getAfter(creditPath).data;
      let creditAmount = request.resource.data.credit_note_total -
        resource.data.get('credit_note_total', 0);
      return creditId is string && creditId != '__missing__' &&
        resource.data.get('credit_note_total', 0) is number &&
        request.resource.data.credit_note_total is number &&
        creditAmount > 0 &&
        !exists(creditPath) && existsAfter(creditPath) &&
        credit is map &&
        credit.type == 'credit_note' &&
        credit.linked_invoice_id == invoiceId &&
        credit.tenant_id == resource.data.tenant_id &&
        credit.shop_id == resource.data.shop_id &&
        credit.route_id == resource.data.get('route_id', '') &&
        credit.total == creditAmount &&
        credit.created_by == request.auth.uid;
    }

    function invoiceCreditNoteVoidUpdateIsLinked(invoiceId) {
      let creditId = request.resource.data.get(
        'voided_credit_note_id',
        '__missing__'
      );
      let creditPath = /databases/$(database)/documents/invoices/$(creditId);
      let creditBefore = get(creditPath).data;
      let creditAfter = getAfter(creditPath).data;
      let creditTotal = creditBefore is map
        ? creditBefore.get('total', 0)
        : 0;
      return creditId is string && creditId != '__missing__' &&
        resource.data.get('credit_note_total', 0) is number &&
        request.resource.data.credit_note_total is number &&
        exists(creditPath) && existsAfter(creditPath) &&
        creditBefore is map && creditAfter is map &&
        creditBefore.status != 'void' &&
        creditTotal is number &&
        creditBefore.type == 'credit_note' &&
        creditBefore.linked_invoice_id == invoiceId &&
        creditAfter.status == 'void' &&
        creditAfter.linked_invoice_id == invoiceId &&
        creditAfter.tenant_id == resource.data.tenant_id &&
        creditAfter.shop_id == resource.data.shop_id &&
        request.resource.data.credit_note_total ==
          resource.data.get('credit_note_total', 0) - creditTotal;
    }

    function invoiceUpdateIsLinked(invoiceId) {
      let totalBefore = resource.data.get('credit_note_total', 0);
      let totalAfter = request.resource.data.get('credit_note_total', 0);
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (
            request.resource.data.status == 'paid' &&
            changed.hasOnly([
              'status',
              'amount_received',
              'outstanding_amount',
              'payment_transaction_ids',
              'latest_payment_transaction_id',
              'updated_at',
            ]) &&
            (invoiceSettlementUpdateIsLinked(invoiceId) ||
              invoicePaidStatusRepairIsValid())
        ) ||
        (request.resource.data.status == 'void' &&
            changed.hasOnly([
              'status',
              'void_by',
              'void_at',
              'void_reason',
              'void_reversal_transaction_id',
              'updated_at',
            ]) &&
            invoiceVoidUpdateIsLinked(invoiceId)) ||
        (totalAfter > totalBefore &&
            changed.hasOnly([
              'credit_note_total',
              'latest_credit_note_invoice_id',
              'updated_at',
            ]) &&
            invoiceCreditNoteCreateUpdateIsLinked(invoiceId)) ||
        (totalAfter < totalBefore &&
            changed.hasOnly([
              'credit_note_total',
              'voided_credit_note_id',
              'updated_at',
            ]) &&
            invoiceCreditNoteVoidUpdateIsLinked(invoiceId));
    }

    function sellerInvoiceTransactionIsLinked(txId, txData) {
      let invoiceId = txData.get('invoice_id', '');
      let invoicePath = /databases/$(database)/documents/invoices/$(invoiceId);
      let invoiceAfter = getAfter(invoicePath).data;
      return invoiceId is string && invoiceId != '' &&
        existsAfter(invoicePath) &&
        invoiceAfter is map &&
        invoiceAfter.shop_id == txData.shop_id &&
        invoiceAfter.route_id == txData.route_id &&
        invoiceAfter.tenant_id == txData.tenant_id &&
        invoiceAfter.created_by == request.auth.uid &&
        (
          (invoiceAfter.type == 'sale' &&
            ((txData.type == 'cash_out' &&
                invoiceAfter.sale_transaction_id == txId &&
                txData.amount == invoiceAfter.total) ||
              (txData.type == 'cash_in' &&
                invoiceAfter.payment_transaction_id == txId &&
                txData.amount == invoiceAfter.amount_received))) ||
          (invoiceAfter.type == 'cash_receipt' &&
            txData.type == 'cash_in' &&
            invoiceAfter.cash_receipt_transaction_id == txId &&
            txData.amount == invoiceAfter.total)
        );
    }

    function transactionCreateIsLinked(txId) {
      let txData = request.resource.data;
      let shopPath = /databases/$(database)/documents/customers/$(txData.shop_id);
      let shopBefore = get(shopPath).data;
      let shopAfter = getAfter(shopPath).data;
      return isSeller() && ('invoice_id' in txData)
        ? sellerInvoiceTransactionIsLinked(txId, txData)
        : transactionCreateShopMatches(txData, shopBefore, shopAfter) &&
          (!('invoice_id' in txData)
            ? standaloneTransactionCreateIsLinked(
                txId,
                txData,
                shopBefore,
                shopAfter
              )
            : invoiceTransactionCreateIsLinked(
                txId,
                txData,
                shopBefore,
                shopAfter
              ));
    }

    function adminTransactionSoftDeleteMatchesShop(txId, shopId) {
      let transactionPath = /databases/$(database)/documents/transactions/$(txId);
      let transactionBefore = get(transactionPath).data;
      let transactionAfter = getAfter(transactionPath).data;
      let shopPath = /databases/$(database)/documents/customers/$(shopId);
      let shopBefore = get(shopPath).data;
      let shopAfter = getAfter(shopPath).data;
      let reversalDelta = transactionBefore.type == 'cash_out'
        ? -transactionBefore.amount
        : transactionBefore.amount;
      return exists(transactionPath) && existsAfter(transactionPath) &&
        transactionBefore.shop_id == shopId &&
        transactionBefore.tenant_id == resource.data.tenant_id &&
        transactionBefore.type in ['cash_in', 'cash_out'] &&
        transactionBefore.amount is number &&
        transactionBefore.amount > 0 &&
        !('invoice_id' in transactionBefore) &&
        transactionBefore.get('deleted', false) != true &&
        transactionAfter.get('deleted', false) == true &&
        transactionAfter.get('deleted_by', '') == request.auth.uid &&
        transactionAfter.get('deleted_at', null) == request.time &&
        transactionAfter.get('updated_at', null) == request.time &&
        transactionAfter.diff(transactionBefore).affectedKeys().hasOnly([
          'deleted', 'deleted_at', 'deleted_by', 'updated_at'
        ]) &&
        shopBefore.balance is number &&
        shopAfter.get('last_balance_correction_transaction_id', '') == txId &&
        shopAfter.balance is number &&
        shopAfter.balance >= shopBefore.balance + reversalDelta - 0.01 &&
        shopAfter.balance <= shopBefore.balance + reversalDelta + 0.01 &&
        (!('last_transaction_id' in shopBefore) ||
          shopBefore.last_transaction_id != txId ||
          (!('last_transaction_at' in shopAfter) &&
            !('last_transaction_type' in shopAfter) &&
            !('last_transaction_amount' in shopAfter) &&
            !('last_transaction_id' in shopAfter)));
    }

    function adminTransactionEditMatchesData(
      txId,
      shopId,
      transactionBefore,
      transactionAfter,
      shopBefore,
      shopAfter
    ) {
      let oldDelta = transactionBefore.type == 'cash_out'
        ? transactionBefore.amount
        : -transactionBefore.amount;
      let newDelta = transactionAfter.type == 'cash_out'
        ? transactionAfter.amount
        : -transactionAfter.amount;
      let expectedBalance = shopBefore.balance - oldDelta + newDelta;
      let cachedId = shopBefore.get('last_transaction_id', '');
      return transactionBefore.shop_id == shopId &&
        transactionBefore.type in ['cash_in', 'cash_out'] &&
        transactionBefore.amount is number &&
        transactionBefore.amount > 0 &&
        transactionBefore.get('deleted', false) != true &&
        !('invoice_id' in transactionBefore) &&
        transactionAfter.shop_id == shopId &&
        transactionAfter.type in ['cash_in', 'cash_out'] &&
        transactionAfter.amount is number &&
        transactionAfter.amount > 0 &&
        transactionAfter.get('deleted', false) != true &&
        !('invoice_id' in transactionAfter) &&
        transactionAfter.diff(transactionBefore).affectedKeys().hasAny([
          'amount', 'type', 'created_at'
        ]) &&
        shopAfter.get('last_balance_correction_transaction_id', '') == txId &&
        shopAfter.balance is number &&
        shopAfter.balance >= expectedBalance - 0.01 &&
        shopAfter.balance <= expectedBalance + 0.01 &&
        (
          (cachedId == txId &&
            shopAfter.get('last_transaction_id', '') == txId &&
            shopAfter.get('last_transaction_type', '') == transactionAfter.type &&
            shopAfter.get('last_transaction_amount', -1) == transactionAfter.amount &&
            shopAfter.get('last_transaction_at', null) ==
              transactionAfter.get('created_at', null)) ||
          (cachedId != txId &&
            shopAfter.get('last_transaction_id', '') == cachedId &&
            shopAfter.get('last_transaction_type', '') ==
              shopBefore.get('last_transaction_type', '') &&
            shopAfter.get('last_transaction_amount', -1) ==
              shopBefore.get('last_transaction_amount', -1) &&
            shopAfter.get('last_transaction_at', null) ==
              shopBefore.get('last_transaction_at', null))
        );
    }

    function adminTransactionEditMatchesTransaction(txId) {
      let shopPath = /databases/$(database)/documents/customers/$(resource.data.shop_id);
      let shopBefore = get(shopPath).data;
      let shopAfter = getAfter(shopPath).data;
      return adminTransactionEditMatchesData(
        txId,
        resource.data.shop_id,
        resource.data,
        request.resource.data,
        shopBefore,
        shopAfter
      );
    }

    function adminTransactionCorrectionMatchesShop(txId, shopId) {
      let transactionPath = /databases/$(database)/documents/transactions/$(txId);
      let transactionBefore = get(transactionPath).data;
      let transactionAfter = getAfter(transactionPath).data;
      return transactionAfter.get('deleted', false) == true
        ? adminTransactionSoftDeleteMatchesShop(txId, shopId)
        : adminTransactionEditMatchesData(
            txId,
            shopId,
            transactionBefore,
            transactionAfter,
            resource.data,
            request.resource.data
          );
    }

    function workspaceAllowsNonStockInvoices(tenantId) {
      let settingsPath = /databases/$(database)/documents/settings/$(tenantId);
      let settingsData = get(settingsPath).data;
      return settingsData is map &&
        'allow_non_stock_invoices' in settingsData &&
        settingsData.allow_non_stock_invoices == true;
    }

    function sellerInvoiceHeaderSnapshotMatchesWorkspace(tenantId) {
      let settingsPath = /databases/$(database)/documents/settings/$(tenantId);
      let settingsData = get(settingsPath).data;
      let snapshot = request.resource.data.invoice_header_snapshot;
      let settingsHeader = settingsData is map
          ? settingsData.get('invoice_header', {})
          : {};
      return settingsData is map &&
        snapshot is map &&
        settingsHeader is map &&
        snapshot.get('company_name', '') ==
          settingsData.get('company_name', '') &&
        snapshot.get('logo_base64', null) ==
          settingsData.get('logo_base64', null) &&
        snapshot.get('document_language_pair', 'english_arabic') ==
          settingsHeader.get('document_language_pair', 'english_arabic') &&
        snapshot.diff(settingsHeader).affectedKeys()
          .hasOnly([
            'company_name',
            'logo_base64',
            'document_language_pair',
          ]);
    }

    function sellerShopBalanceMatchesNewTransaction(shopId, transactionId) {
      let transactionPath = /databases/$(database)/documents/transactions/$(transactionId);
      let transactionData = getAfter(transactionPath).data;
      return !exists(transactionPath) &&
        existsAfter(transactionPath) &&
        transactionData.shop_id == shopId &&
        transactionData.route_id == resource.data.route_id &&
        transactionData.tenant_id == currentUserTenantId() &&
        transactionData.created_by == request.auth.uid &&
        transactionData.amount is number &&
        transactionData.amount > 0 &&
        request.resource.data.last_transaction_type == transactionData.type &&
        request.resource.data.last_transaction_amount == transactionData.amount &&
        (
          (!('invoice_id' in transactionData) &&
            (transactionData.type == 'cash_out' || transactionData.type == 'cash_in') &&
            request.resource.data.balance >= resource.data.balance +
              (transactionData.type == 'cash_out'
                ? transactionData.amount
                : -transactionData.amount) - 0.01 &&
            request.resource.data.balance <= resource.data.balance +
              (transactionData.type == 'cash_out'
                ? transactionData.amount
                : -transactionData.amount) + 0.01) ||
          (('invoice_id' in transactionData) &&
            (transactionData.type == 'cash_out'
              ? sellerInvoiceBalanceMatches(
                  shopId,
                  transactionData,
                  transactionId
                )
              : transactionData.type == 'cash_in' &&
                sellerCashReceiptBalanceMatches(shopId, transactionId, transactionData)))
        );
    }

    function sellerShopFinancialUpdateIsLinked(shopId) {
      return request.resource.data.last_transaction_id is string &&
        request.resource.data.last_transaction_id != '' &&
        sellerShopBalanceMatchesNewTransaction(
          shopId,
          request.resource.data.last_transaction_id
        );
    }

    // --- users --------------------------------------------------------------
    match /users/{userId} {
      // get (single doc): own doc or admin
      allow get: if isOwnDoc(userId) ||
        isAdminForTenant(resource.data.tenant_id);
      allow list: if isAdminForTenant(resource.data.tenant_id);
      allow create: if (
          isAuthenticated() &&
          isConcreteTenantId(request.resource.data.tenant_id) &&
          canAdminCreateUserForTenant(request.resource.data.tenant_id) &&
          request.resource.data.created_by == request.auth.uid &&
          isValidRole(request.resource.data.role) &&
          !isSuperAdminRole(request.resource.data.role) &&
          request.resource.data.active == true &&
          (
            isSuperAdmin() ||
            isSellerRole(request.resource.data.role) ||
            (isTenantAdmin() &&
              request.resource.data.role == 'supervisor')
          ) &&
          tenantSeatCounterMatches(
            get(/databases/$(database)/documents/tenants/$(request.resource.data.tenant_id)).data,
            request.resource.data.tenant_id, userId, 'add'
          ) &&
          (
            request.resource.data.role != 'seller' ||
            (
              request.resource.data.assigned_route_ids is list &&
              request.resource.data.assigned_route_ids.size() > 0
            )
          )
        ) && docSizeOk();
      allow update: if (
        isTenantAdminOnlyRole(getUserRole()) &&
        isSupervisorRole(resource.data.get('role', '')) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['active'])
      ) ? (
        isAuthenticated() &&
        canTenantAdminUpdateSupervisorActive(
          userId, resource.data, request.resource.data
        )
      ) : selfEmailVerificationMatchesAuthToken(userId) ? ((
          isAuthenticated() &&
          canWorkspaceAdminUpdateSeller(
            userId, resource.data, request.resource.data
          )
        ) ||
        (
          isAuthenticated() &&
          canWorkspaceAdminUpdateUser(
            userId, resource.data, request.resource.data
          )
        ) ||
        (
        // Admin can update any user fields (including route assignment) without
        // client write-rate throttling, which otherwise blocks bulk assignment.
        (
          isSuperAdmin() &&
          (isAdminForTenant(resource.data.tenant_id) ||
            isSuperAdminRestoringTenant(resource.data.tenant_id)) &&
          request.resource.data.tenant_id == resource.data.tenant_id &&
          validUserSeatTransition(
            userId,
            resource.data,
            request.resource.data,
            get(/databases/$(database)/documents/tenants/$(resource.data.tenant_id)).data
          ) &&
          (!('role' in request.resource.data) ||
            (!isSuperAdminRole(request.resource.data.role) &&
              (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['role']) ||
                isValidRole(request.resource.data.role)))) &&
          docSizeOk()
        ) ||
        (
          isOwnDoc(userId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'display_name',
              'phone',
              'updated_at',
              'last_active',
              'email',
              'email_verified'
            ]) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['email']) ||
            (request.resource.data.email == request.auth.token.email &&
              request.auth.token.email_verified == true)) &&
          docSizeOk() &&
          withinWriteRate()
        ) ||
        (
          isOwnDoc(userId) &&
          isSuperAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'active_workspace_id',
              'active_workspace_reason',
              'active_workspace_selected_at',
              'active_workspace_access_log_id',
              'last_workspace_access_end_log_id',
              'updated_at'
            ]) &&
          request.resource.data.active_workspace_id is string &&
          exists(/databases/$(database)/documents/tenants/$(request.resource.data.active_workspace_id)) &&
          request.resource.data.active_workspace_reason is string &&
          request.resource.data.active_workspace_reason.size() >= 10 &&
          request.resource.data.active_workspace_reason.size() <= 240 &&
          request.resource.data.active_workspace_selected_at is timestamp &&
          request.resource.data.active_workspace_selected_at == request.time &&
          request.resource.data.active_workspace_access_log_id is string &&
          supportAccessStartLogMatches(
            userId,
            request.resource.data.active_workspace_id,
            request.resource.data.active_workspace_reason,
            request.resource.data.active_workspace_access_log_id
          ) &&
          (
            resource.data.get('active_workspace_id', '') == '' ?
              request.resource.data.get('last_workspace_access_end_log_id', '') ==
                resource.data.get('last_workspace_access_end_log_id', '') :
              hasNewSupportAccessEndLog(
                request.resource.data.get('last_workspace_access_end_log_id', '')
              )
          ) &&
          docSizeOk()
        ) ||
        (
          isOwnDoc(userId) &&
          isSuperAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'active_workspace_id',
              'active_workspace_reason',
              'active_workspace_selected_at',
              'active_workspace_access_log_id',
              'last_workspace_access_end_log_id',
              'updated_at'
            ]) &&
          !('active_workspace_id' in request.resource.data) &&
          !('active_workspace_reason' in request.resource.data) &&
          !('active_workspace_selected_at' in request.resource.data) &&
          !('active_workspace_access_log_id' in request.resource.data) &&
          (
            resource.data.get('active_workspace_id', '') == '' ?
              request.resource.data.get('last_workspace_access_end_log_id', '') ==
                resource.data.get('last_workspace_access_end_log_id', '') :
              hasNewSupportAccessEndLog(
                request.resource.data.get('last_workspace_access_end_log_id', '')
              )
          ) &&
          docSizeOk()
        )
      )) : false;
      allow delete: if isSuperAdmin() &&
        isAdminForTenant(resource.data.tenant_id) &&
        resource.data.get('active', false) != true;
    }

    // --- tenants -----------------------------------------------------------
    match /tenants/{tenantId} {
      allow get: if canAccessTenant(tenantId) ||
        (isActiveUser() && !isSuperAdminRole(getUserRole()) &&
          currentUserTenantId() == tenantId);
      allow list: if isSuperAdmin() || (
        isTenantAdmin() &&
        resource.data.tenant_id == currentUserTenantId()
      );
      allow create: if isSuperAdmin() &&
        tenantId != '__global__' &&
        request.resource.data.tenant_id == tenantId &&
        request.resource.data.created_by == request.auth.uid &&
        request.resource.data.created_at is timestamp &&
        request.resource.data.created_at == request.time &&
        request.resource.data.plan == 'free' &&
        request.resource.data.active_user_count == 0 &&
        request.resource.data.max_active_users == 10 &&
        request.resource.data.seat_count_revision == 0 &&
        docSizeOk();
      allow update: if (
          isAuthenticated() &&
          canUpdateTenantSeatCounter(tenantId) &&
          validTenantSeatCounterUpdate(tenantId) &&
          docSizeOk()
        ) ||
        (
          isSuperAdminForSelectedWorkspace(tenantId) &&
          request.resource.data.tenant_id == tenantId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'slug', 'owner_user_id', 'updated_at', 'active',
            'archived_at', 'archived_by'
          ]) &&
          validTenantLifecycleTransition(resource.data, request.resource.data) &&
          request.resource.data.updated_at == request.time && docSizeOk()
        ) ||
        (
          isSuperAdminForSelectedWorkspace(tenantId) &&
          validSeatCounterInitialization(tenantId)
        ) ||
        (
          isSuperAdminForSelectedWorkspace(tenantId) &&
          validSeatCounterReconciliation(tenantId)
        );
      // Workspace lifecycle is archive/restore only; hard-delete can orphan
      // tenant-scoped business records.
      allow delete: if false;
    }

    // --- products -----------------------------------------------------------
    match /products/{productId} {
      allow read: if isOperationalForTenant(resource.data.tenant_id) ||
        (isActiveUser() && !isSuperAdminRole(getUserRole()) &&
         isTenantActive(resource.data.tenant_id) &&
         resource.data.tenant_id == currentUserTenantId());
      // P0-2 FIX: products are tenant-owned; use isAdminForTenant check
      allow create: if isOperationalForTenant(request.resource.data.tenant_id) &&
        isConcreteTenantId(request.resource.data.tenant_id) &&
        request.resource.data.name is string &&
        request.resource.data.name != '' && docSizeOk()
        && (!('image_url' in request.resource.data)
          || !(request.resource.data.image_url is string)
          || request.resource.data.image_url == ''
          || request.resource.data.image_url.matches('https://.*'));
      allow update: if isOperationalForTenant(resource.data.tenant_id) &&
        request.resource.data.tenant_id == resource.data.tenant_id &&
        (!('name' in request.resource.data) ||
          (request.resource.data.name is string &&
            request.resource.data.name != '')) &&
        docSizeOk()
        && (!('image_url' in request.resource.data)
          || !(request.resource.data.image_url is string)
          || request.resource.data.image_url == ''
          || request.resource.data.image_url.matches('https://.*'));
      allow delete: if isSuperAdmin() &&
        isOperationalForTenant(resource.data.tenant_id);
    }

    // --- product_variants ---------------------------------------------------
    match /product_variants/{variantId} {
      allow read: if isOperationalForTenant(resource.data.tenant_id) ||
        (isActiveUser() && !isSuperAdminRole(getUserRole()) &&
         isTenantActive(resource.data.tenant_id) &&
         resource.data.tenant_id == currentUserTenantId());
      // P0-2 FIX: product_variants are tenant-owned; use isAdminForTenant check
      allow create: if isOperationalForTenant(request.resource.data.tenant_id) &&
        isConcreteTenantId(request.resource.data.tenant_id) &&
        request.resource.data.product_id is string &&
        request.resource.data.product_id != '' &&
        request.resource.data.variant_name is string &&
        request.resource.data.variant_name != '' &&
        request.resource.data.quantity_available is number &&
        request.resource.data.quantity_available >= 0 && docSizeOk();
      allow update: if isOperationalForTenant(resource.data.tenant_id) &&
        request.resource.data.tenant_id == resource.data.tenant_id &&
        (!('product_id' in request.resource.data) ||
          (request.resource.data.product_id is string &&
            request.resource.data.product_id != '')) &&
        (!('variant_name' in request.resource.data) ||
          (request.resource.data.variant_name is string &&
            request.resource.data.variant_name != '')) &&
        (!('quantity_available' in request.resource.data) ||
          (request.resource.data.quantity_available is number &&
            request.resource.data.quantity_available >= 0)) && docSizeOk();
      allow delete: if isSuperAdmin() &&
        isOperationalForTenant(resource.data.tenant_id);
    }

    // --- routes -------------------------------------------------------------
    match /routes/{routeId} {
      // isSellerForRoute(routeId) covers single-document GET requests
      // (routeId is known). For LIST/query operations the match-path variable
      // is NOT constrained by query filters, so Firestore can't prove it.
      // The second branch checks the document field directly — Firestore CAN
      // validate this against an arrayContains query constraint.
      allow read: if isOperationalForTenant(resource.data.tenant_id) ||
        (isSeller() && isSellerForRoute(routeId) &&
         resource.data.tenant_id == currentUserTenantId()) ||
        (isSeller() && request.auth.uid in resource.data.assigned_seller_ids &&
         isTenantActive(resource.data.tenant_id) &&
         resource.data.tenant_id == currentUserTenantId());
      // P0-2 FIX: routes are tenant-owned; use isAdminForTenant check
      allow create: if isOperationalForTenant(request.resource.data.tenant_id) &&
        isConcreteTenantId(request.resource.data.tenant_id) &&
        request.resource.data.name is string &&
        request.resource.data.name != '' &&
        request.resource.data.route_number is int &&
        request.resource.data.route_number >= 0 &&
        request.resource.data.total_shops is number &&
        request.resource.data.total_shops >= 0 && docSizeOk();
      allow update: if (
        (
          isOperationalForTenant(resource.data.tenant_id) &&
          request.resource.data.tenant_id == resource.data.tenant_id &&
          (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['assigned_seller_ids', 'assigned_seller_names']) ||
            isAdminForTenant(resource.data.tenant_id)) &&
          (!('name' in request.resource.data) ||
            (request.resource.data.name is string &&
              request.resource.data.name != '')) &&
          (!('route_number' in request.resource.data) ||
            (request.resource.data.route_number is int &&
              request.resource.data.route_number >= 0)) &&
          (!('total_shops' in request.resource.data) ||
            (request.resource.data.total_shops is number &&
              request.resource.data.total_shops >= 0))
        ) ||
        sellerRouteShopCountUpdateIsLinked(routeId)
      ) && docSizeOk();
      allow delete: if isSuperAdmin() &&
        isOperationalForTenant(resource.data.tenant_id);
    }

    // --- customers (= shops) ------------------------------------------------
    // This collection stores RETAIL SHOPS only. The collection name 'customers'
    // is legacy and kept to avoid a data migration. App code uses ShopModel
    // and Collections.shops alias. No separate Customer entity exists.
    //
    // BALANCE FIELD: balance > 0 means shop owes us money (accounts receivable).
    // Updated atomically with every transaction/invoice write.
    match /customers/{customerId} {
      allow read: if isOperationalForTenant(resource.data.tenant_id) ||
        (
          isSeller() &&
          resource.data.route_id != null &&
          isSellerForRoute(resource.data.route_id) &&
          resource.data.tenant_id == currentUserTenantId()
        );
      // Sellers must include a non-empty route_id when creating customers
      // P0-2 FIX: customers are tenant-owned; use isAdminForTenant check
      allow create: if isConcreteTenantId(request.resource.data.tenant_id) &&
        request.resource.data.balance is number &&
        request.resource.data.balance == 0 &&
        !request.resource.data.keys().hasAny([
          'last_transaction_at', 'last_transaction_type',
          'last_transaction_amount', 'last_transaction_id'
        ]) &&
        (isOperationalForTenant(request.resource.data.tenant_id) ||
        (
          isSeller() &&
          request.resource.data.name is string &&
          request.resource.data.name != '' &&
          request.resource.data.route_id is string &&
          request.resource.data.route_id != '' &&
          isSellerForRoute(request.resource.data.route_id) &&
          request.resource.data.tenant_id == currentUserTenantId() &&
          request.resource.data.balance is number &&
          request.resource.data.balance == 0 &&
          !('last_transaction_id' in request.resource.data)
        )) && docSizeOk();
      // Sellers can update customers in their own route only.
      // SR-08: withinWriteRate() removed from customers — financial ledger writes
      // (balance increments from invoice batches) must not be throttled; atomic
      // WriteBatch integrity is the correct guard, not a 1-second time gate.
      // P0-2 FIX: customers are tenant-owned; use isAdminForTenant check
      allow update: if (isOperationalForTenant(resource.data.tenant_id) &&
        request.resource.data.tenant_id == resource.data.tenant_id &&
        (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['route_id']) ||
          isAdminForTenant(resource.data.tenant_id)) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'balance', 'last_transaction_at', 'last_transaction_type',
            'last_transaction_amount', 'last_transaction_id'
          ]) ||
          (request.resource.data.get('last_transaction_id', '') !=
              resource.data.get('last_transaction_id', '') &&
            adminShopFinancialUpdateIsLinked(customerId)) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'balance', 'updated_at',
              'last_balance_correction_transaction_id',
              'last_transaction_at', 'last_transaction_type',
              'last_transaction_amount', 'last_transaction_id'
            ]) &&
              request.resource.data.get(
                'last_balance_correction_transaction_id', ''
              ) is string &&
              (
                adminTransactionCorrectionMatchesShop(
                  request.resource.data.get(
                    'last_balance_correction_transaction_id', ''
                  ),
                  customerId
                )
              ))
        ) ||
        (
          isSeller() &&
          resource.data.route_id is string &&
          resource.data.route_id != '' &&
          isSellerForRoute(resource.data.route_id) &&
          resource.data.tenant_id == currentUserTenantId() &&
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'phone', 'address', 'area', 'city', 'contact_name',
              'notes', 'latitude', 'longitude', 'updated_at'
            ]) ||
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'name', 'phone', 'address', 'area', 'city', 'contact_name',
                'notes', 'latitude', 'longitude', 'updated_at', 'balance',
                'last_transaction_at', 'last_transaction_type',
                'last_transaction_amount', 'last_transaction_id'
              ]) &&
              request.resource.data.diff(resource.data).affectedKeys().hasAny([
                'balance', 'last_transaction_at', 'last_transaction_type',
                'last_transaction_amount', 'last_transaction_id'
              ]) &&
              sellerShopFinancialUpdateIsLinked(customerId)
            )
          )
        )) && docSizeOk();
      allow delete: if isSuperAdmin() &&
        isOperationalForTenant(resource.data.tenant_id);
    }

    // --- transactions -------------------------------------------------------
    // Ledger entries for shop accounts. Two creation pathways:
    //   1. Via InvoiceNotifier.createSaleInvoice() \u2014 sale with stock deduction
    //      (type: cash_out, linked via invoice_id + invoice_number)
    //   2. Via TransactionNotifier.create() \u2014 cash collection from existing debt
    //      (type: cash_in, no invoice_id, no items)
    // Allowed types: cash_in | cash_out | return | payment | write_off
    match /transactions/{txId} {
      // Seller can read only route-owned transactions.
      // P0-2 FIX: transactions are tenant-owned; use isAdminForTenant check
      allow read: if canReadMissingTenantDocument(true) ||
        isOperationalForTenant(resource.data.tenant_id) ||
        isSellerRouteTransaction();
      // Field validation: type must be in allowed set, amount must be positive
      allow create: if request.resource.data.tenant_id is string &&
        isConcreteTenantId(request.resource.data.tenant_id) &&
        request.resource.data.tenant_id == currentUserTenantId() &&
        (isOperationalForTenant(request.resource.data.tenant_id) ||
        (
          isSeller() &&
          request.resource.data.created_by == request.auth.uid &&
          request.resource.data.shop_id != null &&
          request.resource.data.shop_id != '' &&
          isValidSellerTransactionType(request.resource.data.type) &&
          request.resource.data.amount is number &&
          request.resource.data.amount > 0 &&
          request.resource.data.route_id != null &&
          request.resource.data.route_id != '' &&
          isSellerForRoute(request.resource.data.route_id) &&
          (!('invoice_id' in request.resource.data) ||
            isSellerForShop(request.resource.data.shop_id))
        )) &&
        (isAdminRole(getUserRole()) ||
          request.resource.data.type == 'cash_in' ||
          request.resource.data.type == 'cash_out') &&
        transactionCreateIsLinked(txId) && docSizeOk()
        // Admin also requires valid type and positive amount for integrity
        && (isSeller() || (
          isValidTransactionType(request.resource.data.type) &&
          request.resource.data.amount is number &&
          request.resource.data.amount > 0
        ));
      // Sellers may annotate their own entries or submit a pending edit request.
      // Amount, type, and date remain immutable unless an admin applies the edit.
      allow update: if isAdminRole(getUserRole())
        ? (isAdminForTenant(resource.data.tenant_id) &&
          request.resource.data.tenant_id == resource.data.tenant_id &&
          isValidTransactionType(request.resource.data.type) &&
          (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['deleted', 'deleted_at', 'deleted_by']) ||
            (request.resource.data.get('deleted', false) == true &&
              request.resource.data.get('deleted_by', '') == request.auth.uid &&
              request.resource.data.get('deleted_at', null) == request.time &&
              request.resource.data.get('updated_at', null) == request.time &&
              request.resource.data.shop_id is string &&
              request.resource.data.shop_id != '' &&
              adminTransactionSoftDeleteMatchesShop(
                txId,
                request.resource.data.shop_id
              ))) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'amount', 'type', 'created_at'
          ]) || (hasValidTransactionEditHistory() &&
            adminTransactionEditMatchesTransaction(txId))) &&
            (!('invoice_id' in resource.data &&
              resource.data.invoice_id is string &&
              resource.data.invoice_id != '') ||
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'amount', 'type', 'created_at'
            ])))
        : (
          requestIsSellerRouteTransaction() &&
          resource.data.created_by == request.auth.uid &&
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'description', 'updated_at', 'updated_by'
            ]) ||
            (
              requiresSellerTransactionEditApproval() &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'description',
                'updated_at',
                'updated_by',
                'edit_request_pending',
                'edit_request_status',
                'edit_request_requested_by',
                'edit_request_requested_at',
                'edit_request_new_amount',
                'edit_request_new_type',
                'edit_request_new_description',
                'edit_request_new_sale_type',
                'edit_request_new_created_at'
              ]) &&
              request.resource.data.edit_request_pending == true &&
              request.resource.data.edit_request_status == 'pending' &&
              (!('edit_request_new_type' in request.resource.data) ||
                isValidSellerTransactionType(request.resource.data.edit_request_new_type)) &&
              (!('edit_request_new_amount' in request.resource.data) ||
                (request.resource.data.edit_request_new_amount is number &&
                  request.resource.data.edit_request_new_amount > 0))
            )
          )
        );
      allow delete: if false;
    }

    // --- seller inventory ---------------------------------------------------
    match /seller_inventory/{docId} {
      // P0-2 FIX: seller_inventory is tenant-owned; use isAdminForTenant check
      allow read: if canReadMissingTenantDocument(false) ||
        isOperationalForTenant(resource.data.tenant_id) ||
        (isSeller() && resource.data.seller_id == request.auth.uid &&
         isTenantActive(resource.data.tenant_id) &&
         resource.data.tenant_id == currentUserTenantId());
      allow create: if isOperationalForTenant(request.resource.data.tenant_id) &&
        isConcreteTenantId(request.resource.data.tenant_id) &&
        request.resource.data.tenant_id == currentUserTenantId() &&
        sellerInventoryCreateMatchesWarehouse() && docSizeOk();
      allow delete: if isSuperAdmin() &&
        isOperationalForTenant(resource.data.tenant_id);
      // Sellers may only decrease their own stock; allocations are admin-only.
      // Post-state quantity_available must stay >= 0 to prevent negative stock.
      // SR-07: withinWriteRate() intentionally excluded here — rapid sequential
      // sales (two invoices < 1 ms apart) would otherwise block the second
      // stock deduction, creating ghost inventory discrepancies. The
      // quantity_available may not increase outside an admin allocation.
        allow update: if (isOperationalForTenant(resource.data.tenant_id) &&
          request.resource.data.tenant_id == resource.data.tenant_id &&
          request.resource.data.quantity_available is number &&
          request.resource.data.quantity_available >= 0 ||
        (
          isSeller() &&
          resource.data.seller_id == request.auth.uid &&
          isTenantActive(resource.data.tenant_id) &&
          resource.data.tenant_id == currentUserTenantId() &&
          request.resource.data.quantity_available <= resource.data.quantity_available &&
          request.resource.data.quantity_available >= 0 &&
          sellerInventoryDecreaseMatchesInvoice(docId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['quantity_available', 'updated_at', 'last_sale_invoice_id'])
        )) && docSizeOk();
    }

    // --- inventory transactions (audit log for all stock movements) ---------
    match /inventory_transactions/{docId} {
      // P0-2 FIX: inventory_transactions are tenant-owned; use isAdminForTenant check
      allow read: if isOperationalForTenant(resource.data.tenant_id) ||
        (isSeller() && resource.data.seller_id == request.auth.uid &&
         isTenantActive(resource.data.tenant_id) &&
         resource.data.tenant_id == currentUserTenantId());
      allow create: if isConcreteTenantId(request.resource.data.tenant_id) &&
        (isOperationalForTenant(request.resource.data.tenant_id) ||
        (
          isSeller() &&
          request.resource.data.seller_id == request.auth.uid &&
          request.resource.data.created_by == request.auth.uid &&
          isTenantActive(request.resource.data.tenant_id) &&
          request.resource.data.tenant_id == currentUserTenantId()
        ))
        && isValidInventoryTransactionType(request.resource.data.type)
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && docSizeOk();
      allow update, delete: if false;
    }

    // --- settings -----------------------------------------------------------
    match /settings/{docId} {
      allow read: if canReadMissingWorkspaceSettings(docId) ||
        isAdminForTenant(docId) ||
        (isActiveUser() &&
         isTenantActive(docId) &&
         (docId == currentUserTenantId() ||
          (docId == '__global__' && currentUserTenantId() == null)));
      // P0-2 FIX: settings docs are tenant-owned (docId = tenant_id); use isAdminForTenant check
      allow create: if isConcreteTenantId(docId) &&
        (isAdminForTenant(docId) || (
        isSuperAdmin() &&
        !exists(/databases/$(database)/documents/tenants/$(docId)) &&
        existsAfter(/databases/$(database)/documents/tenants/$(docId)) &&
        getAfter(/databases/$(database)/documents/tenants/$(docId)).data.created_by == request.auth.uid &&
        getAfter(/databases/$(database)/documents/tenants/$(docId)).data.created_at == request.time &&
        request.resource.data.tenant_id == docId
      ));
      allow delete: if isSuperAdmin() && isAdminForTenant(docId);
      // Admin: full update.
      // Sellers may increment either tenant-scoped sequence by exactly 1.
      allow update: if (
        isAdminForTenant(docId) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['last_invoice_number', 'last_invoice_id']) ||
          invoiceCounterUpdateIsLinked(docId)
        )
      ) ||
        (isActiveUser() &&
         isTenantActive(docId) &&
         docId == currentUserTenantId() &&
         (
           (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['last_invoice_number', 'last_invoice_id']) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasAll(['last_invoice_number', 'last_invoice_id']) &&
            invoiceCounterUpdateIsLinked(docId)) ||
           (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['last_cash_receipt_number']) &&
            request.resource.data.last_cash_receipt_number is number &&
            ((('last_cash_receipt_number' in resource.data) &&
              resource.data.last_cash_receipt_number is number &&
              request.resource.data.last_cash_receipt_number ==
                resource.data.last_cash_receipt_number + 1) ||
             (!('last_cash_receipt_number' in resource.data) &&
              request.resource.data.last_cash_receipt_number == 1)))
         )) && docSizeOk();
    }

    // --- invoices -----------------------------------------------------------
    match /invoices/{invoiceId} {
      // P0-2 FIX: invoices are tenant-owned; use isAdminForTenant check
      allow read: if canReadMissingTenantDocument(true) ||
        isOperationalForTenant(resource.data.tenant_id) ||
        (
          isSeller() && (
            (resource.data.seller_id == request.auth.uid &&
             isTenantActive(resource.data.tenant_id) &&
             resource.data.tenant_id == currentUserTenantId()) ||
            (resource.data.route_id != null &&
             resource.data.route_id != '' &&
             isSellerForRoute(resource.data.route_id) &&
             resource.data.tenant_id == currentUserTenantId())
          )
        );
      allow create: if request.resource.data.type in [
          'sale',
          'cash_receipt',
          'credit_note',
        ] &&
        isConcreteTenantId(request.resource.data.tenant_id) &&
        (isOperationalForTenant(request.resource.data.tenant_id) ||
        (
          sellerInvoiceScopeMatches(request.resource.data) &&
          request.resource.data.created_by == request.auth.uid &&
          (request.resource.data.type == 'sale' ||
           request.resource.data.type == 'cash_receipt') &&
          request.resource.data.shop_id != null &&
          request.resource.data.shop_id != '' &&
          request.resource.data.route_id != null &&
          request.resource.data.route_id != ''
        )) &&
        request.resource.data.created_by == request.auth.uid
        // Invoice math integrity: total must equal subtotal minus discount
        && request.resource.data.total is number
        && request.resource.data.subtotal is number
        && request.resource.data.discount is number
        && request.resource.data.items is list
        && request.resource.data.subtotal >= 0
        && request.resource.data.discount >= 0
        && request.resource.data.total > 0
        && request.resource.data.amount_received is number
        && request.resource.data.amount_received >= 0
        && request.resource.data.amount_received <= request.resource.data.total + 0.01
        && (
          (request.resource.data.type == 'cash_receipt' &&
           request.resource.data.items is list &&
           request.resource.data.items.size() == 0 &&
           request.resource.data.subtotal == 0 &&
           request.resource.data.discount == 0 &&
           request.resource.data.amount_received == request.resource.data.total &&
           request.resource.data.fulfillment_mode == 'none' &&
           sellerCashReceiptIsLinked(invoiceId)) ||
          (request.resource.data.type != 'cash_receipt' &&
           request.resource.data.items is list &&
           request.resource.data.items.size() > 0 &&
           request.resource.data.total >= request.resource.data.subtotal - request.resource.data.discount - 0.01 &&
           request.resource.data.total <= request.resource.data.subtotal - request.resource.data.discount + 0.01)
        )
        && (request.resource.data.type != 'sale' ||
          (
            (request.resource.data.fulfillment_mode == 'stock' &&
             request.resource.data.seller_inventory_deductions is map &&
             request.resource.data.seller_inventory_deductions.size() > 0) ||
            (request.resource.data.fulfillment_mode == 'non_stock' &&
             request.resource.data.seller_inventory_deductions is map &&
             request.resource.data.seller_inventory_deductions.size() == 0 &&
             workspaceAllowsNonStockInvoices(request.resource.data.tenant_id))
          ))
        && (request.resource.data.type != 'credit_note' ||
          (isAdminForTenant(request.resource.data.tenant_id) &&
           isValidCreditNoteLink(invoiceId) && creditNoteIsLinked(invoiceId)))
        && (request.resource.data.type != 'sale' || saleInvoiceIsLinked(invoiceId))
        && (!isSeller() ||
          !('invoice_header_snapshot' in request.resource.data) ||
          sellerInvoiceHeaderSnapshotMatchesWorkspace(
            request.resource.data.tenant_id
          ))
        && docSizeOk();
      allow update: if isAdminForTenant(resource.data.tenant_id) &&
        request.resource.data.tenant_id == resource.data.tenant_id &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'amount_received',
          'outstanding_amount',
          'payment_transaction_ids',
          'latest_payment_transaction_id',
          'credit_note_total',
          'latest_credit_note_invoice_id',
          'voided_credit_note_id',
          'void_reversal_transaction_id',
          'void_by',
          'void_at',
          'void_reason',
          'updated_at',
        ]) &&
        invoiceUpdateIsLinked(invoiceId) &&
        docSizeOk();
      allow delete: if isSuperAdmin() &&
        isAdminForTenant(resource.data.tenant_id);
    }

    // --- admin_config (legacy credential path; client access is forbidden) ---
    match /admin_config/{docId} {
      // Service-account credentials must never be readable from a client APK,
      // including by admins. AdminIdentityService now requires an explicit
      // build-time credential and does not use this collection.
      allow read: if false;
      allow write: if false;
    }

    // --- notifications (Firestore-listener notification feed) ----------------
    // Admins and supervisors read/mark-read within their tenant. Sellers may
    // create one source-linked notification after its business write commits.
    match /notifications/{notifId} {
      allow read: if isNotificationReaderForTenant(resource.data.tenant_id);
      allow create: if isActiveUser()
          && isSeller()
          && isSellerForRoute(request.resource.data.route_id)
          && request.resource.data.created_by == request.auth.uid
          && request.resource.data.seller_id == request.auth.uid
          && isConcreteTenantId(request.resource.data.tenant_id)
          && isTenantActive(request.resource.data.tenant_id)
          && request.resource.data.tenant_id == currentUserTenantId()
          && request.resource.data.created_at is timestamp
          && request.resource.data.created_at == request.time
          && request.resource.data.shop_id is string
          && request.resource.data.shop_id.size() > 0
          && request.resource.data.route_id is string
          && request.resource.data.route_id.size() > 0
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.target_role == 'admin'
          && request.resource.data.read == false
          && (
            (
              request.resource.data.type == 'invoice' &&
              request.resource.data.transaction_type == 'cash_out' &&
              notificationIsLinkedToInvoice(notifId)
            ) ||
            (
              request.resource.data.type == 'transaction' &&
              isValidSellerTransactionType(
                request.resource.data.transaction_type
              ) &&
              notificationIsLinkedToTransaction(notifId)
            )
          )
          && docSizeOk();
      allow update: if isNotificationReaderForTenant(resource.data.tenant_id)
          && isNotificationMarkRead();
      allow delete: if false;
    }

    // Append-only record of explicitly reasoned platform support access.
    match /platform_access_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin() &&
        request.resource.data.actor_user_id == request.auth.uid &&
        request.resource.data.workspace_id is string &&
        isConcreteTenantId(request.resource.data.workspace_id) &&
        exists(/databases/$(database)/documents/tenants/$(request.resource.data.workspace_id)) &&
        request.resource.data.event_type in ['workspace_access_started', 'workspace_access_ended'] &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 10 &&
        request.resource.data.reason.size() <= 240 &&
        request.resource.data.created_at is timestamp &&
        request.resource.data.created_at == request.time &&
        request.resource.data.keys().hasOnly([
          'actor_user_id', 'workspace_id', 'event_type', 'reason',
          'started_log_id', 'created_at'
        ]) &&
        (request.resource.data.event_type == 'workspace_access_started' ?
        isLinkedSupportAccessStartLog(logId) :
        isLinkedSupportAccessEndLog(logId)) &&
        docSizeOk();
      allow update, delete: if false;
    }

    // --- Deny all other paths -----------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
